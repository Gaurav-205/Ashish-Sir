# ---------------------------------------------------------------------------
# Konfident Interview 2025 — environment template
# Copy to `.env` (which is git-ignored) and fill in real values.
# Every variable below is optional unless marked REQUIRED.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=3000
# development | production | test
NODE_ENV=development

# REQUIRED IN PRODUCTION. The process refuses to start without it when
# NODE_ENV=production. Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# --- Database --------------------------------------------------------------
# Driver selection:
#   (unset)          -> Postgres when DATABASE_URL is set and DB_PATH is not,
#                       otherwise the local SQLite file.
#   DB_DRIVER=sqlite   -> always the local SQLite file (recommended for dev).
#   DB_DRIVER=postgres -> always Postgres; requires DATABASE_URL.
# The active driver is printed at startup.
DB_DRIVER=sqlite

# Override the SQLite file location. Defaults to ./data/konfident.db
# DB_PATH=./data/konfident.db

# Neon / Postgres. Only needed when running with DB_DRIVER=postgres (or on Vercel).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# MongoDB Connection URL
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/konfident?retryWrites=true&w=majority

# --- Root administrator (used by `npm run init` / `npm run seed`) -----------
# If ADMIN_PASSWORD is left blank, `npm run init` generates one and prints it
# once. Copy it before clearing your terminal.
ADMIN_EMAIL=admin@yourinstitution.edu
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator

# --- Password recovery -----------------------------------------------------
# No mail provider is wired in. Reset links are always written to the server
# log; they are additionally shown in the browser outside production.
#   true  -> always show the link on screen
#   false -> never show it (log only)
# RESET_LINK_VISIBLE=

# --- Google OAuth & Calendar sync (optional) -------------------------------
# Leave blank to disable Google sign-in and calendar sync entirely; the app
# degrades gracefully and hides the integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. When unset, the callback URL is derived from the incoming request,
# which is what you want behind Vercel or a custom domain.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# --- Email Notifications (optional SMTP) -----------------------------------
# When unset, booking confirmation and cancellation emails are logged to the
# server console and recorded in the audit_logs table.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@konfident.kalvium.community
