<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Evaluator Pool · Mentor Management
    </div>
    <h1>Mentors &amp; evaluators</h1>
    <p class="sub">Manage verified mentors, configure Technical/HR permissions, and inspect slot capacities.</p>
  </div>
  <button type="button" class="btn primary" onclick="document.getElementById('registerMentorModal').showModal()" style="display:inline-flex;align-items:center;gap:6px">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
    </svg>
    Register Mentor
  </button>
</div>

<dialog id="registerMentorModal" class="modal-dialog" style="max-width:540px">
  <div class="modal-head">
    <h2>Register a New Mentor</h2>
    <button type="button" class="modal-close-btn" onclick="document.getElementById('registerMentorModal').close()" aria-label="Close">&times;</button>
  </div>
  <form method="post" action="/admin/mentors" style="margin:0">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="modal-body">
      <div class="row">
        <div class="field"><label>Full Name *</label><input name="name" placeholder="e.g. Arjun Mehta" required></div>
        <div class="field"><label>Email Address *</label><input type="email" name="email" placeholder="arjun.mentor@konfident.in" required></div>
      </div>
      <div class="row">
        <div class="field"><label>Initial Password *</label><input type="password" name="password" placeholder="At least 6 characters" required minlength="6"></div>
        <div class="field"><label>Contact Phone</label><input name="phone" placeholder="+91 98765 43210"></div>
      </div>
      <div style="display:flex;gap:18px;margin:12px 0 6px;flex-wrap:wrap">
        <label class="check"><input type="checkbox" name="can_technical" id="reg_can_technical" value="1" checked onchange="validateMentorDomains()"> Can conduct Technical interviews</label>
        <label class="check"><input type="checkbox" name="can_hr" id="reg_can_hr" value="1" onchange="validateMentorDomains()"> Can conduct HR interviews</label>
      </div>
      <div id="domain_err_msg" style="color:var(--error);font-size:12px;display:none;margin-top:4px">
        ⚠️ Please select at least one interview domain (Technical or HR).
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" onclick="document.getElementById('registerMentorModal').close()">Cancel</button>
      <button class="btn primary" id="reg_mentor_btn">Register Mentor →</button>
    </div>
  </form>
</dialog>

<div class="search-toolbar" style="margin-bottom:20px">
  <div class="search-input-wrap">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input type="text" id="mentorAdminSearchInput" placeholder="Search evaluators by name, email, domain…" oninput="filterMentorsTable()">
  </div>
  <div class="filter-chips">
    <button type="button" class="filter-chip active" onclick="setAdminMentorFilter('all', this)">All (<%= mentors.length %>)</button>
    <button type="button" class="filter-chip" onclick="setAdminMentorFilter('technical', this)">Technical (<%= mentors.filter(m => m.can_technical).length %>)</button>
    <button type="button" class="filter-chip" onclick="setAdminMentorFilter('hr', this)">HR (<%= mentors.filter(m => m.can_hr).length %>)</button>
    <button type="button" class="filter-chip" onclick="setAdminMentorFilter('active', this)">Active (<%= mentors.filter(m => m.active).length %>)</button>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Verified Evaluators (<%= mentors.length %>)</h2>
    <span class="faint" id="mentorCountLabel">Showing all <%= mentors.length %> evaluator(s)</span>
  </div>
  <div class="card-body tight">
    <div class="table-scroll"><table id="mentorsTable">
      <thead><tr><th>Mentor</th><th>Domains</th><th class="num">Published Slots</th><th class="num">Upcoming</th>
        <th class="num">Completed</th><th class="num">Action</th></tr></thead>
      <tbody>
      <% mentors.forEach(function(m){ %>
        <tr data-tech="<%= m.can_technical ? '1' : '0' %>" data-hr="<%= m.can_hr ? '1' : '0' %>" data-active="<%= m.active ? '1' : '0' %>">
          <td><strong><%= m.name %></strong><br><span class="faint"><%= m.email %><%= m.phone ? ' · ' + m.phone : '' %></span>
            <% if (!m.active) { %> <span class="pill p-cancelled" style="font-size:10px">inactive</span><% } %></td>
          <td><% if (m.can_technical) { %><span class="pill p-technical">Technical</span> <% } %>
              <% if (m.can_hr) { %><span class="pill p-hr">HR</span><% } %>
              <% if (!m.can_technical && !m.can_hr) { %><span class="faint">—</span><% } %></td>
          <td class="num font-mono"><strong><%= m.slot_count %></strong></td>
          <td class="num font-mono"><%= m.upcoming %></td>
          <td class="num font-mono"><%= m.done %></td>
          <td class="num">
            <button type="button" class="btn sm" onclick='openEditMentorModal(<%- JSON.stringify({ id: m.id, name: m.name, phone: m.phone || "", can_technical: !!m.can_technical, can_hr: !!m.can_hr, active: !!m.active }).replace(/'/g, "&#39;").replace(/</g, "\\u003c") %>)'>Edit Profile</button>
          </td>
        </tr>
      <% }); %>
      <% if (!mentors.length) { %><tr><td colspan="6" class="empty">No mentors registered yet.</td></tr><% } %>
      </tbody>
    </table></div>
  </div>
</div>

<dialog id="editMentorModal" class="modal-dialog" style="max-width:520px">
  <div class="modal-head">
    <h2 id="edit_mentor_title">Edit Evaluator Profile</h2>
    <button type="button" class="modal-close-btn" onclick="document.getElementById('editMentorModal').close()" aria-label="Close">&times;</button>
  </div>
  <div class="modal-body">
    <form id="edit_mentor_form" method="post" action="">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row">
        <div class="field"><label>Full Name *</label><input name="name" id="em_name" required></div>
        <div class="field"><label>Phone Number</label><input name="phone" id="em_phone" placeholder="+91 98765 43210"></div>
      </div>
      <div style="display:flex;gap:14px;margin:12px 0 16px;flex-wrap:wrap">
        <label class="check"><input type="checkbox" name="can_technical" id="em_can_technical" value="1"> Technical Interviews</label>
        <label class="check"><input type="checkbox" name="can_hr" id="em_can_hr" value="1"> HR Interviews</label>
        <label class="check"><input type="checkbox" name="active" id="em_active" value="1"> Active Account</label>
      </div>
      <button class="btn primary" style="width:100%">Save Profile Changes →</button>
    </form>

    <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--line)">
      <h3 style="font-size:14px;margin:0 0 8px">Administrative Password Reset</h3>
      <p class="faint" style="font-size:12px;margin:0 0 12px">Require your admin password to securely reset this evaluator's login.</p>
      <form id="reset_mentor_pw_form" method="post" action="">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row">
          <div class="field">
            <label>Admin Password</label>
            <input name="admin_password" type="password" placeholder="Your admin password" required>
          </div>
          <div class="field">
            <label>New Evaluator Password</label>
            <input name="password" type="password" autocomplete="new-password" placeholder="New password" minlength="6" required>
          </div>
        </div>
        <button class="btn sm" style="width:100%;margin-top:6px">Reset Password</button>
      </form>
    </div>
  </div>
  <div class="modal-foot">
    <button type="button" class="btn" onclick="document.getElementById('editMentorModal').close()">Close</button>
  </div>
</dialog>

<script>
function validateMentorDomains() {
  var t = document.getElementById('reg_can_technical');
  var h = document.getElementById('reg_can_hr');
  var err = document.getElementById('domain_err_msg');
  var btn = document.getElementById('reg_mentor_btn');
  var isValid = (t && t.checked) || (h && h.checked);
  if (err) err.style.display = isValid ? 'none' : 'block';
  if (btn) btn.disabled = !isValid;
  return isValid;
}

var currentAdminMentorFilter = 'all';

function setAdminMentorFilter(domain, btn) {
  document.querySelectorAll('.filter-chip').forEach(function(c) { c.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  currentAdminMentorFilter = domain;
  filterMentorsTable();
}

function filterMentorsTable() {
  var search = (document.getElementById('mentorAdminSearchInput').value || '').trim().toLowerCase();
  var rows = document.querySelectorAll('#mentorsTable tbody tr');
  var count = 0;

  rows.forEach(function(r) {
    var text = r.textContent.toLowerCase();
    var isTech = r.getAttribute('data-tech') === '1';
    var isHr = r.getAttribute('data-hr') === '1';
    var isActive = r.getAttribute('data-active') === '1';

    var matchesDomain = (currentAdminMentorFilter === 'all') ||
      (currentAdminMentorFilter === 'technical' && isTech) ||
      (currentAdminMentorFilter === 'hr' && isHr) ||
      (currentAdminMentorFilter === 'active' && isActive);

    var matchesSearch = !search || text.indexOf(search) !== -1;

    if (matchesDomain && matchesSearch) {
      r.style.display = '';
      count++;
    } else {
      r.style.display = 'none';
    }
  });

  var label = document.getElementById('mentorCountLabel');
  if (label) label.textContent = 'Showing ' + count + ' evaluator(s)';
}

window.openEditMentorModal = function (mentor) {
  var modal = document.getElementById('editMentorModal');
  if (!modal || !mentor) return;

  var titleEl = document.getElementById('edit_mentor_title');
  if (titleEl) {
    titleEl.textContent = 'Edit Profile — ' + mentor.name;
  }

  var editForm = document.getElementById('edit_mentor_form');
  if (editForm) {
    editForm.action = '/admin/mentors/' + mentor.id + '/update';
  }

  var pwForm = document.getElementById('reset_mentor_pw_form');
  if (pwForm) {
    pwForm.action = '/admin/mentors/' + mentor.id + '/reset-password';
  }

  var nameEl = document.getElementById('em_name');
  var phoneEl = document.getElementById('em_phone');
  var canTechEl = document.getElementById('em_can_technical');
  var canHrEl = document.getElementById('em_can_hr');
  var activeEl = document.getElementById('em_active');

  if (nameEl) nameEl.value = mentor.name || '';
  if (phoneEl) phoneEl.value = mentor.phone || '';
  if (canTechEl) canTechEl.checked = !!mentor.can_technical;
  if (canHrEl) canHrEl.checked = !!mentor.can_hr;
  if (activeEl) activeEl.checked = !!mentor.active;

  modal.showModal();
};
</script>
<%- include('../partials/foot') %>
