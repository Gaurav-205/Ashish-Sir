<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Evaluator Pool · Mentor Management
    </div>
    <h1>Mentors &amp; evaluators</h1>
    <p class="sub">Manage verified mentors, configure Technical/HR permissions, and inspect slot capacities.</p>
  </div>
</div>

<div class="card" style="margin-bottom:24px">
  <div class="card-head"><h2>Register a new mentor</h2></div>
  <div class="card-body">
    <form method="post" action="/admin/mentors">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row">
        <div class="field"><label>Full Name *</label><input name="name" placeholder="e.g. Arjun Mehta" required></div>
        <div class="field"><label>Email Address *</label><input type="email" name="email" placeholder="arjun.mentor@konfident.in" required></div>
        <div class="field"><label>Initial Password *</label><input type="password" name="password" placeholder="At least 6 characters" required minlength="6"></div>
        <div class="field"><label>Contact Phone</label><input name="phone" placeholder="+91 98765 43210"></div>
      </div>
      <div style="display:flex;gap:18px;margin:12px 0 16px;flex-wrap:wrap">
        <label class="check"><input type="checkbox" name="can_technical" value="1" checked> Can conduct Technical interviews</label>
        <label class="check"><input type="checkbox" name="can_hr" value="1"> Can conduct HR interviews</label>
      </div>
      <button class="btn primary">Register Mentor →</button>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-head"><h2>Verified Evaluators (<%= mentors.length %>)</h2></div>
  <div class="card-body tight">
    <div class="table-scroll"><table>
      <thead><tr><th>Mentor</th><th>Domains</th><th class="num">Published Slots</th><th class="num">Upcoming</th>
        <th class="num">Completed</th><th class="num">Action</th></tr></thead>
      <tbody>
      <% mentors.forEach(function(m){ %>
        <tr>
          <td><strong><%= m.name %></strong><br><span class="faint"><%= m.email %></span>
            <% if (!m.active) { %> <span class="pill p-cancelled">inactive</span><% } %></td>
          <td><% if (m.can_technical) { %><span class="pill p-technical">Technical</span> <% } %>
              <% if (m.can_hr) { %><span class="pill p-hr">HR</span><% } %>
              <% if (!m.can_technical && !m.can_hr) { %><span class="faint">—</span><% } %></td>
          <td class="num font-mono"><strong><%= m.slot_count %></strong></td>
          <td class="num font-mono"><%= m.upcoming %></td>
          <td class="num font-mono"><%= m.done %></td>
          <td class="num">
            <details class="inline"><summary>Edit profile</summary>
              <div class="panel">
                <form method="post" action="/admin/mentors/<%= m.id %>/update">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="row">
                    <div class="field"><label>Name</label><input name="name" value="<%= m.name %>" required></div>
                    <div class="field"><label>Phone</label><input name="phone" value="<%= m.phone || '' %>"></div>
                  </div>
                  <div style="display:flex;gap:12px;margin:8px 0;flex-wrap:wrap">
                    <label class="check"><input type="checkbox" name="can_technical" value="1" <%= m.can_technical ? 'checked' : '' %>> Technical</label>
                    <label class="check"><input type="checkbox" name="can_hr" value="1" <%= m.can_hr ? 'checked' : '' %>> HR</label>
                    <label class="check"><input type="checkbox" name="active" value="1" <%= m.active ? 'checked' : '' %>> Active</label>
                  </div>
                  <button class="btn primary sm">Save changes</button>
                </form>
                <form method="post" action="/admin/mentors/<%= m.id %>/reset-password" class="btn-row" style="margin-top:12px;padding-top:12px;border-top:1px solid var(--line-soft)">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input name="admin_password" type="password" placeholder="Your admin password" required style="max-width:160px">
                  <input name="password" type="password" autocomplete="new-password" placeholder="New password" minlength="6" required style="max-width:160px">
                  <button class="btn sm">Reset password</button>
                </form>
              </div>
            </details>
          </td>
        </tr>
      <% }); %>
      <% if (!mentors.length) { %><tr><td colspan="6" class="empty">No mentors registered yet.</td></tr><% } %>
      </tbody>
    </table></div>
  </div>
</div>
<%- include('../partials/foot') %>
