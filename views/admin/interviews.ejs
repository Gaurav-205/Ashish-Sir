<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Interview Lifecycle · Global Records
    </div>
    <h1>All interviews</h1>
    <p class="sub"><%= list.length %> interview record(s) — tracking schedule, mentor assignments, meeting attendance, and rubric scores.</p>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Interview Sessions</h2>
    <form method="get" class="btn-row" style="margin:0">
      <select name="type" onchange="this.form.submit()" style="font-size:13px;padding:6px 12px;border-radius:var(--radius-pill);max-width:140px">
        <option value="">All domains</option>
        <option value="technical" <%= filters.type==='technical'?'selected':'' %>>Technical</option>
        <option value="hr" <%= filters.type==='hr'?'selected':'' %>>HR</option>
      </select>
      <select name="status" onchange="this.form.submit()" style="font-size:13px;padding:6px 12px;border-radius:var(--radius-pill);max-width:140px">
        <option value="">All statuses</option>
        <option value="booked" <%= filters.status==='booked'?'selected':'' %>>Booked</option>
        <option value="completed" <%= filters.status==='completed'?'selected':'' %>>Completed</option>
        <option value="cancelled" <%= filters.status==='cancelled'?'selected':'' %>>Cancelled</option>
      </select>
      <select name="attendance" onchange="this.form.submit()" style="font-size:13px;padding:6px 12px;border-radius:var(--radius-pill);max-width:160px">
        <option value="">All attendance</option>
        <option value="attended" <%= filters.attendance==='attended'?'selected':'' %>>Attended</option>
        <option value="absent" <%= filters.attendance==='absent'?'selected':'' %>>Absent / No-Show</option>
        <option value="pending" <%= filters.attendance==='pending'?'selected':'' %>>Attendance Pending</option>
      </select>
      <select name="mentor" onchange="this.form.submit()" style="font-size:13px;padding:6px 12px;border-radius:var(--radius-pill);max-width:160px">
        <option value="">All mentors</option>
        <% mentors.forEach(function(m){ %>
          <option value="<%= m.id %>" <%= String(filters.mentor)===String(m.id)?'selected':'' %>><%= m.name %></option>
        <% }); %>
      </select>
    </form>
  </div>
  <div class="card-body tight">
    <div class="table-scroll"><table>
      <thead><tr><th>When</th><th>Domain</th><th>Candidate</th><th>Assigned Mentor</th><th>Status</th><th>Attendance</th><th>Category Marks</th><th class="num">Score</th><th>Action</th></tr></thead>
      <tbody>
      <% list.forEach(function(i){ %>
        <tr>
          <td><%= h.fmtDate(i.slot_date) %><br><span class="faint"><%= h.fmtTime(i.start_time) %> – <%= h.fmtTime(i.end_time) %></span></td>
          <td><span class="pill p-<%= i.type %>"><%= h.titleCase(i.type) %></span></td>
          <td><a href="/admin/students/<%= i.student_id %>"><strong><%= i.student_name %></strong></a><br><span class="faint"><%= i.roll_no || '' %></span></td>
          <td><%= i.mentor_name %><% if (i.location) { %><br><span class="faint"><%- h.linkify(i.location) %></span><% } %></td>
          <td><span class="pill p-<%= i.status %>"><%= i.status %></span>
            <% if (i.status === 'completed' && !i.eval_id) { %><br><span class="faint">awaiting score</span><% } %></td>
          <td>
            <% if (i.attendance === 'attended') { %>
              <span class="pill p-completed">Attended (Present)</span>
            <% } else if (i.attendance === 'absent') { %>
              <span class="pill p-cancelled">Absent</span>
            <% } else if (h.isPast(i)) { %>
              <span class="pill p-warn" style="background:#fef3c7;color:#92400e;border:1px solid #fde68a">Slot Passed · Pending</span>
            <% } else { %>
              <span class="pill p-booked">Pending</span>
            <% } %>
          </td>
          <td><% if (i.eval_id) { RUBRIC[i.type].criteria.forEach(function(c){ %>
                <span class="pill p-muted"><%= c.label.split(' ')[0] %> <%= i[c.key] %>/<%= c.max %></span>
              <% }); } else { %><span class="faint">—</span><% } %></td>
          <td class="num"><% if (i.eval_id) { %><strong style="font-family:var(--font-display)"><%= i.score %></strong><span class="faint">/<%= RUBRIC[i.type].total %></span>
            <% } else { %><span class="faint">—</span><% } %></td>
          <td>
            <% if (i.status === 'booked' && i.attendance === 'pending') { %>
              <form method="post" action="/admin/interviews/<%= i.id %>/cancel" onsubmit="return confirm('Cancel this booking? The slot will reopen for booking.')" style="margin:0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn sm danger">Cancel booking</button>
              </form>
            <% } else { %>
              <span class="faint">—</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
      <% if (!list.length) { %><tr><td colspan="9" class="empty">No interview records match the selected filters.</td></tr><% } %>
      </tbody>
    </table></div>
  </div>
</div>
<%- include('../partials/foot') %>
