<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px;display:flex;align-items:center">
      <span class="live-pulse"></span> Platform Administration · Live Telemetry
    </div>
    <h1>Admin dashboard</h1>
    <p class="sub">Comprehensive monitoring of interview slots, candidate bookings, mentor assignments, and evaluation progress.</p>
  </div>
  <div class="btn-row">
    <a class="btn" href="/admin/slots">+ Create slots</a>
    <a class="btn" href="/admin/students">All candidates</a>
    <a class="btn primary" href="/admin/reports">View reports &amp; CSV →</a>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="n"><%= stats.students %></div><div class="l">Registered Students</div></div>
  <div class="stat"><div class="n"><%= stats.mentors %></div><div class="l">Verified Mentors</div></div>
  <div class="stat"><div class="n"><%= stats.openSlots %><small class="faint"> / <%= stats.slots %></small></div><div class="l">Open Slots</div></div>
  <div class="stat"><div class="n"><%= stats.fullyBooked %><small class="faint"> / <%= stats.students %></small></div><div class="l">Fully Booked</div></div>
  <div class="stat"><div class="n"><%= stats.booked %></div><div class="l">Upcoming</div></div>
  <div class="stat"><div class="n"><%= stats.attended %><small class="faint"> / <%= stats.completed %></small></div><div class="l">Attended / Completed</div></div>
  <div class="stat"><div class="n"><%= stats.evaluated %></div><div class="l">Evaluated</div></div>
</div>

<div class="grid two" style="margin-bottom:24px">
  <div class="card">
    <div class="card-head">
      <h2>Upcoming scheduled interviews</h2>
      <a class="btn sm" href="/admin/interviews?status=booked">View all →</a>
    </div>
    <div class="card-body tight">
      <% if (!upcoming.length) { %><div class="empty">Nothing booked yet.</div><% } else { %>
      <div class="table-scroll"><table>
        <thead><tr><th>When</th><th>Type</th><th>Student</th><th>Mentor / Meet Link</th></tr></thead>
        <tbody><% upcoming.forEach(function(i){ %>
          <tr>
            <td><%= h.fmtDate(i.slot_date) %><br><span class="faint"><%= h.fmtTime(i.start_time) %></span></td>
            <td><span class="pill p-<%= i.type %>"><%= h.titleCase(i.type) %></span></td>
            <td><strong><%= i.student_name %></strong></td>
            <td><%= i.mentor_name %><% if (i.location) { %><br><span class="faint"><%- h.linkify(i.location) %></span><% } %></td>
          </tr><% }); %></tbody>
      </table></div><% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head">
      <h2>Completed sessions awaiting scores</h2>
    </div>
    <div class="card-body tight">
      <% if (!pendingEval.length) { %><div class="empty">Every completed interview has been evaluated.</div><% } else { %>
      <div class="table-scroll"><table>
        <thead><tr><th>Student</th><th>Type</th><th>Mentor / Meet Link</th><th>Date</th></tr></thead>
        <tbody><% pendingEval.forEach(function(i){ %>
          <tr>
            <td><strong><%= i.student_name %></strong></td>
            <td><span class="pill p-<%= i.type %>"><%= h.titleCase(i.type) %></span></td>
            <td><%= i.mentor_name %><% if (i.location) { %><br><span class="faint"><%- h.linkify(i.location) %></span><% } %></td>
            <td class="faint"><%= h.fmtDate(i.slot_date) %></td>
          </tr>
        <% }); %></tbody>
      </table></div><% } %>
    </div>
  </div>
</div>

<div class="card" style="margin-bottom:24px">
  <div class="card-head" style="flex-wrap:wrap;gap:12px">
    <div>
      <h2>Student Interview Breakdown (Technical &amp; HR Lists)</h2>
      <span class="faint">Separate Technical and HR interview records for every registered student</span>
    </div>
    <div style="min-width:240px">
      <input type="text" id="adminStudentFilter" placeholder="Filter by candidate, roll no..." style="padding:6px 14px;font-size:12px;border:1px solid var(--line);border-radius:var(--radius-pill);width:100%" onkeyup="filterBreakdownTable()">
    </div>
  </div>
  <div class="card-body tight">
    <% if (typeof studentSummaries === 'undefined' || !studentSummaries || !studentSummaries.length) { %><div class="empty">No students registered yet.</div><% } else { %>
    <div class="table-scroll"><table id="studentBreakdownTable">
      <thead>
        <tr>
          <th>Roll No</th>
          <th>Student</th>
          <th>Technical Interview</th>
          <th>HR Interview</th>
          <th class="num">Score</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% studentSummaries.forEach(function(s){ %>
        <tr>
          <td class="mono"><%= s.student.roll_no || '—' %></td>
          <td>
            <strong><%= s.student.name %></strong><br>
            <span class="faint"><%= s.student.email %><%= s.student.branch ? ' · ' + s.student.branch : '' %></span>
          </td>
          <td>
            <% if (!s.technical) { %>
              <span class="pill p-cancelled">Not Booked</span>
            <% } else { %>
              <span class="pill p-<%= s.technical.status %>"><%= h.titleCase(s.technical.status) %></span>
              <div class="faint" style="margin-top:4px">
                <%= h.fmtDate(s.technical.slot_date) %> · <%= h.fmtTime(s.technical.start_time) %><br>
                Mentor: <%= s.technical.mentor_name %>
                <% if (s.technical.location) { %><br><%- h.linkify(s.technical.location) %><% } %>
              </div>
            <% } %>
          </td>
          <td>
            <% if (!s.hr) { %>
              <span class="pill p-cancelled">Not Booked</span>
            <% } else { %>
              <span class="pill p-<%= s.hr.status %>"><%= h.titleCase(s.hr.status) %></span>
              <div class="faint" style="margin-top:4px">
                <%= h.fmtDate(s.hr.slot_date) %> · <%= h.fmtTime(s.hr.start_time) %><br>
                Mentor: <%= s.hr.mentor_name %>
                <% if (s.hr.location) { %><br><%- h.linkify(s.hr.location) %><% } %>
              </div>
            <% } %>
          </td>
          <td class="num">
            <% if (s.allEvaluated) { %>
              <strong><%= s.total %></strong><span class="faint">/<%= GRAND_TOTAL %></span>
            <% } else { %>
              <span class="faint">—</span>
            <% } %>
          </td>
          <td class="num">
            <a class="btn sm" href="/admin/students/<%= s.student.id %>">View</a>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table></div><% } %>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Students with incomplete bookings</h2>
    <span class="faint">Each candidate requires 1 Technical + 1 HR within the placement week</span>
  </div>
  <div class="card-body tight">
    <% if (!notBooked.length) { %>
      <div class="empty">Every student has booked both interviews.</div>
    <% } else { %>
    <div class="table-scroll"><table>
      <thead><tr><th>Roll No</th><th>Student Name</th><th>Booking Status</th><th class="num">Action</th></tr></thead>
      <tbody><% notBooked.forEach(function(s){ %>
        <tr>
          <td class="mono"><strong><%= s.roll_no || '—' %></strong></td>
          <td><%= s.name %><br><span class="faint"><%= s.email %></span></td>
          <td><span class="pill <%= s.booked === 0 ? 'p-cancelled' : 'p-booked' %>"><%= s.booked %> of 2 booked</span></td>
          <td class="num"><a class="btn sm" href="/admin/students/<%= s.id %>">View record →</a></td>
        </tr>
      <% }); %></tbody>
    </table></div><% } %>
  </div>
</div>
<script>
function filterBreakdownTable() {
  const query = (document.getElementById('adminStudentFilter').value || '').toLowerCase().trim();
  const rows = document.querySelectorAll('#studentBreakdownTable tbody tr');
  rows.forEach(r => {
    const text = r.textContent.toLowerCase();
    r.style.display = text.includes(query) ? '' : 'none';
  });
}
</script>
<%- include('../partials/foot') %>
