<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <h1>Interview slots</h1>
    <p class="sub">Students can only book from slots you publish here. One slot = one student.</p>
  </div>
  <div class="btn-row">
    <% if (techMentors.length || hrMentors.length) { %>
      <button type="button" class="btn primary" onclick="document.getElementById('createSlotModal').showModal()">+ Create Slots</button>
    <% } %>
    <% if (total > 0) { %>
      <form method="post" action="/admin/slots/delete-all" style="display:inline" onsubmit="return confirm('Are you sure you want to delete ALL slots? This cannot be undone.')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn danger sm">Delete All Slots</button>
      </form>
    <% } %>
  </div>
</div>

<% if (techMentors.length || hrMentors.length) { %>
<dialog id="createSlotModal" class="modal-dialog" style="max-width:540px">
  <div class="modal-head">
    <h2>Create Interview Slots</h2>
    <button type="button" class="modal-close-btn" onclick="document.getElementById('createSlotModal').close()" aria-label="Close">&times;</button>
  </div>
  <form method="post" action="/admin/slots" style="margin:0">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="modal-body">
      <div class="field">
        <label>Interview Type *</label>
        <select name="type" id="typeSel" required>
          <% if (techMentors.length) { %><option value="technical">Technical Mock Interview</option><% } %>
          <% if (hrMentors.length) { %><option value="hr">HR Mock Interview</option><% } %>
        </select>
      </div>
      <div class="field">
        <label>Assigned Mentor *</label>
        <select name="mentor_id" id="mentorSel" required>
          <% techMentors.forEach(function(m){ %><option value="<%= m.id %>" data-type="technical"><%= m.name %></option><% }); %>
          <% hrMentors.forEach(function(m){ %><option value="<%= m.id %>" data-type="hr" hidden><%= m.name %></option><% }); %>
        </select>
        <div class="hint">Only mentors enabled for that interview type are listed.</div>
      </div>

      <div class="field">
        <label>Select Date(s) from Calendar *</label>
        <div id="adm_date_picker_container"></div>
        <input type="hidden" name="selected_dates" id="adm_selected_dates" value="<%= typeof defaultDate !== 'undefined' ? defaultDate : '' %>">
        <input type="hidden" name="slot_date" id="adm_slot_date" value="<%= typeof defaultDate !== 'undefined' ? defaultDate : '' %>">
      </div>

      <div class="row">
        <div class="field">
          <label>Daily Start Time *</label>
          <input type="time" name="start_time" id="adm_start_time" value="09:00" step="300" required onchange="updateAdminPreview()">
        </div>
        <div class="field">
          <label>Slot Length (minutes)</label>
          <input type="number" name="duration" id="adm_duration" value="30" min="10" max="180" onchange="updateAdminPreview()" oninput="updateAdminPreview()">
        </div>
        <div class="field">
          <label>Slots Per Day (Back-to-back)</label>
          <input type="number" name="count" id="adm_count" value="1" min="1" max="30" onchange="updateAdminPreview()" oninput="updateAdminPreview()">
        </div>
      </div>

      <div class="field">
        <label>Mode</label>
        <select name="mode">
          <option>Online (Auto Google Meet)</option>
          <option>Offline</option>
        </select>
      </div>

      <div id="adm_preview_text" style="margin-top:10px;padding:10px 14px;background:var(--surface-alt);border-radius:8px;font-size:13px;font-weight:600;color:var(--action-blue, #2563eb)">
        ⚡ Generating 1 slot across 1 selected day = 1 total slot
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" onclick="document.getElementById('createSlotModal').close()">Cancel</button>
      <button class="btn primary">Create Slots →</button>
    </div>
  </form>
</dialog>
<% } else { %>
  <div class="note" style="margin-bottom:24px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
    <span>No evaluators are enabled for Technical or HR interviews yet, so there is nobody to publish slots for.</span>
    <a class="btn sm primary" href="/admin/mentors">Register a mentor →</a>
  </div>
<% } %>

<!-- Manage Slot Modal Dialog -->
<dialog id="manageSlotModal" class="modal-dialog" style="max-width:500px">
  <div class="modal-head">
    <h2 id="mng_title">Manage Slot</h2>
    <button type="button" class="modal-close-btn" onclick="document.getElementById('manageSlotModal').close()" aria-label="Close">&times;</button>
  </div>
  <div class="modal-body">
    <!-- Allotment Section (if open) -->
    <div id="mng_allot_section" style="display:none;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid var(--line-soft)">
      <form id="mng_allot_form" method="post" action="">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label style="font-weight:600">Allot Slot to Student</label>
          <select name="student_id" id="mng_student_id" required>
            <option value="">— Select student —</option>
            <% (students || []).forEach(function(st){ %>
              <option value="<%= st.id %>"><%= st.name %> (<%= st.roll_no || st.email %>)</option>
            <% }); %>
          </select>
        </div>
        <button class="btn primary sm" style="width:100%">Allot slot to student →</button>
      </form>
    </div>

    <!-- Reschedule / Edit Section -->
    <div id="mng_reschedule_section">
      <form id="mng_reschedule_form" method="post" action="">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row">
          <div class="field"><label>Date</label><input type="date" name="slot_date" id="mng_slot_date" required min="<%= typeof today !== 'undefined' ? today : '' %>"></div>
          <div class="field"><label>Start</label><input type="time" name="start_time" id="mng_start_time" required step="300"></div>
          <div class="field"><label>End</label><input type="time" name="end_time" id="mng_end_time" required step="300"></div>
        </div>
        <div class="field"><label>Mentor</label>
          <select name="mentor_id" id="mng_mentor_id">
            <% [...techMentors, ...hrMentors].forEach(function(m){ %>
              <option value="<%= m.id %>"><%= m.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="field"><label>Mode</label>
          <select name="mode" id="mng_mode">
            <option value="Online">Online</option>
            <option value="Offline">Offline</option>
          </select>
        </div>
        <button class="btn primary sm" style="margin-top:8px">Save / Reschedule Slot</button>
      </form>
    </div>

    <!-- Actions Section (Release, Cancel, Reopen, Delete) -->
    <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--line-soft);display:flex;gap:8px;flex-wrap:wrap">
      <form id="mng_release_form" method="post" action="" style="display:none">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn sm">Release Booking</button>
      </form>
      <form id="mng_cancel_form" method="post" action="" style="display:none" onsubmit="return confirm('Cancel this slot?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn sm">Cancel Slot</button>
      </form>
      <form id="mng_reopen_form" method="post" action="" style="display:none">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn sm">Reopen Slot</button>
      </form>
      <form id="mng_delete_form" method="post" action="" style="display:none" onsubmit="return confirm('Are you sure you want to permanently delete this slot? This action cannot be undone.')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn sm danger">Delete Slot Permanently</button>
      </form>
    </div>
  </div>
  <div class="modal-foot">
    <button type="button" class="btn" onclick="document.getElementById('manageSlotModal').close()">Close</button>
  </div>
</dialog>

<div class="card">
  <div class="card-head">
    <h2>All slots (<%= total %>)</h2>
    <form method="get" class="btn-row">
      <select name="when" onchange="this.form.submit()">
        <option value="upcoming" <%= filter.when==='upcoming'?'selected':'' %>>Today &amp; upcoming</option>
        <option value="past" <%= filter.when==='past'?'selected':'' %>>Past</option>
        <option value="all" <%= filter.when==='all'?'selected':'' %>>All dates</option>
      </select>
      <input type="date" name="date" value="<%= filter.date %>" onchange="this.form.submit()" style="max-width:170px">
      <select name="mentor" onchange="this.form.submit()">
        <option value="">All mentors</option>
        <% [...techMentors, ...hrMentors].filter((v,i,a)=>a.findIndex(t=>(t.id===v.id))===i).forEach(function(m){ %>
          <option value="<%= m.id %>" <%= filter.mentor == m.id ? 'selected' : '' %>><%= m.name %></option>
        <% }); %>
      </select>
      <select name="type" onchange="this.form.submit()">
        <option value="">All types</option>
        <option value="technical" <%= filter.type==='technical'?'selected':'' %>>Technical</option>
        <option value="hr" <%= filter.type==='hr'?'selected':'' %>>HR</option>
      </select>
      <select name="status" onchange="this.form.submit()">
        <option value="">All statuses</option>
        <option value="open" <%= filter.status==='open'?'selected':'' %>>Open</option>
        <option value="booked" <%= filter.status==='booked'?'selected':'' %>>Booked</option>
        <option value="cancelled" <%= filter.status==='cancelled'?'selected':'' %>>Cancelled</option>
      </select>
    </form>
  </div>
  <div class="card-body tight">
    <div class="table-scroll"><table>
      <thead><tr><th>Date &amp; time</th><th>Type</th><th>Mentor</th><th>Status</th><th>Booked by</th><th></th></tr></thead>
      <tbody>
      <% slots.forEach(function(s){ %>
        <tr>
          <td><%= h.fmtDate(s.slot_date) %><br><span class="faint"><%= h.fmtTime(s.start_time) %> – <%= h.fmtTime(s.end_time) %></span></td>
          <td><span class="pill p-<%= s.type %>"><%= h.titleCase(s.type) %></span></td>
          <td><%= s.mentor_name %><br><span class="faint"><%= s.mode %><% if (s.status !== 'open' && s.location) { %> · <%- h.linkify(s.location) %><% } %></span></td>
          <td><span class="pill p-<%= s.status %>"><%= s.status %></span>
              <% if (s.interview_status === 'completed') { %><br><span class="pill p-completed">interview done</span><% } %></td>
          <td><% if (s.student_name) { %><%= s.student_name %><br><span class="faint"><%= s.roll_no || '' %></span>
              <% } else { %><span class="faint">—</span><% } %></td>
          <td class="num">
            <button type="button" class="btn sm" onclick='openSlotManageModal(<%- JSON.stringify(s).replace(/'/g, "&#39;").replace(/</g, "\\u003c") %>)'>Manage</button>
          </td>
        </tr>
      <% }); %>
      <% if (!slots.length) { %>
        <tr>
          <td colspan="6" class="empty" style="padding:48px 20px;text-align:center">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--slate);margin-bottom:10px">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <div style="font-weight:600;font-size:14px;color:var(--ink);margin-bottom:4px">No slots match the selected filters.</div>
            <div class="faint" style="margin-bottom:14px">Try changing the date, mentor, type, or status filter.</div>
            <a class="btn sm" href="/admin/slots">Reset Filters</a>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table></div>
    <% if (pageCount > 1) { %>
      <nav class="pager" aria-label="Slot pages">
        <% const qs = baseQuery ? baseQuery + '&' : ''; %>
        <a class="btn sm <%= page <= 1 ? 'is-disabled' : '' %>"
           href="?<%= qs %>page=<%= page - 1 %>"
           <%= page <= 1 ? 'aria-disabled="true" tabindex="-1"' : '' %>>← Previous</a>
        <span class="faint">Page <%= page %> of <%= pageCount %> · <%= total %> slot(s)</span>
        <a class="btn sm <%= page >= pageCount ? 'is-disabled' : '' %>"
           href="?<%= qs %>page=<%= page + 1 %>"
           <%= page >= pageCount ? 'aria-disabled="true" tabindex="-1"' : '' %>>Next →</a>
      </nav>
    <% } %>
  </div>
</div>
<script src="/js/multi-date-picker.js"></script>
<script src="/js/admin-slots.js"></script>
<%- include('../partials/foot') %>
