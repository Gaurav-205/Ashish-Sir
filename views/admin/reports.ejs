<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Performance Analytics · Cohort Score Sheet
    </div>
    <h1>Cohort evaluations &amp; reports</h1>
    <p class="sub">Aggregate marks scored across Technical (30 marks) and HR (20 marks) — Total <%= GRAND_TOTAL %> marks.</p>
  </div>
  <a class="btn primary" href="/admin/reports.csv" style="display:inline-flex;align-items:center;gap:8px">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    Export Data to CSV
  </a>
</div>

<div class="stats">
  <div class="stat"><div class="n"><%= doneCount %><small class="faint"> / <%= summaries.length %></small></div><div class="l">Fully Evaluated</div></div>
  <div class="stat"><div class="n"><%= avg == null ? '—' : avg.toFixed(1) %></div><div class="l">Cohort Average /<%= GRAND_TOTAL %></div></div>
  <div class="stat"><div class="n"><%= avgTech == null ? '—' : avgTech.toFixed(1) %></div><div class="l">Avg Technical /<%= RUBRIC.technical.total %></div></div>
  <div class="stat"><div class="n"><%= avgHr == null ? '—' : avgHr.toFixed(1) %></div><div class="l">Avg HR /<%= RUBRIC.hr.total %></div></div>
  <div class="stat"><div class="n"><%= stats.attended %></div><div class="l">Sessions Attended</div></div>
</div>

<div class="search-toolbar" style="margin-bottom:20px">
  <div class="search-input-wrap">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input type="text" id="reportSearchInput" placeholder="Search report by student name, roll no, email..." onkeyup="filterReportTable()">
  </div>
  <div class="filter-chips">
    <button type="button" class="filter-chip active" onclick="setReportSquadFilter('all', this)">All (<%= summaries.length %>)</button>
    <button type="button" class="filter-chip" onclick="setReportSquadFilter('116', this)">Squad 116 (<%= summaries.filter(s => (s.student.squad === '116')).length %>)</button>
    <button type="button" class="filter-chip" onclick="setReportSquadFilter('115', this)">Squad 115 (<%= summaries.filter(s => (s.student.squad === '115')).length %>)</button>
    <button type="button" class="filter-chip" onclick="setReportSquadFilter('evaluated', this)">Evaluated (<%= doneCount %>)</button>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Comprehensive Cohort Score Sheet</h2>
    <span class="faint" id="reportCountLabel">Showing all <%= summaries.length %> candidate records</span>
  </div>
  <div class="card-body tight">
    <div class="table-scroll"><table class="report" id="reportTable">
      <thead><tr>
        <th>Roll No</th>
        <th>Student</th>
        <th>Squad</th>
        <% RUBRIC.technical.criteria.forEach(function(c){ %><th class="num"><%= c.label %></th><% }); %>
        <th class="num">Tech /<%= RUBRIC.technical.total %></th>
        <% RUBRIC.hr.criteria.forEach(function(c){ %><th class="num"><%= c.label %></th><% }); %>
        <th class="num">HR /<%= RUBRIC.hr.total %></th>
        <th class="num">Total /<%= GRAND_TOTAL %></th>
        <th>Grade &amp; Status</th>
      </tr></thead>
      <tbody>
      <% summaries.forEach(function(s){ 
         const squadVal = s.student.squad || '';
      %>
        <tr data-squad="<%= squadVal %>" data-evaluated="<%= s.allEvaluated ? '1' : '0' %>">
          <td class="mono"><strong><%= s.student.roll_no || '—' %></strong></td>
          <td><a href="/admin/students/<%= s.student.id %>"><strong><%= s.student.name %></strong></a><br><span class="faint"><%= s.student.email %></span></td>
          <td>
            <% if (s.student.squad) { %>
              <span class="pill p-<%= s.student.squad === '116' ? 'technical' : 'hr' %>">Squad <%= s.student.squad %></span>
            <% } else { %>
              <span class="faint">—</span>
            <% } %>
          </td>
          <% RUBRIC.technical.criteria.forEach(function(c){ %>
            <td class="num"><%= s.technical && s.technical.eval_id ? s.technical[c.key] : '—' %></td><% }); %>
          <td class="num"><strong style="font-family:var(--font-display)"><%= s.techScore == null ? '—' : s.techScore %></strong></td>
          <% RUBRIC.hr.criteria.forEach(function(c){ %>
            <td class="num"><%= s.hr && s.hr.eval_id ? s.hr[c.key] : '—' %></td><% }); %>
          <td class="num"><strong style="font-family:var(--font-display)"><%= s.hrScore == null ? '—' : s.hrScore %></strong></td>
          <td class="num"><strong style="font-family:var(--font-display);font-size:15px"><%= s.total == null ? '—' : s.total %></strong></td>
          <td>
            <% if (s.allEvaluated) { %>
              <span class="pill <%= grade(s.percent).cls %>"><%= grade(s.percent).label %> · <%= s.percent %>%</span>
            <% } else { %>
              <span class="pill p-booked">In progress</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
      <% if (!summaries.length) { %><tr><td colspan="12" class="empty">No student records found.</td></tr><% } %>
      </tbody>
    </table></div>
  </div>
</div>

<script>
var currentReportSquadFilter = 'all';

function setReportSquadFilter(squad, btn) {
  currentReportSquadFilter = squad;
  document.querySelectorAll('.search-toolbar .filter-chip').forEach(function(c) { c.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  filterReportTable();
}

function filterReportTable() {
  var query = (document.getElementById('reportSearchInput').value || '').toLowerCase().trim();
  var rows = document.querySelectorAll('#reportTable tbody tr');
  var visibleCount = 0;

  rows.forEach(function(r) {
    var text = r.textContent.toLowerCase();
    var rowSquad = r.getAttribute('data-squad') || '';
    var isEvaluated = r.getAttribute('data-evaluated') === '1';

    var matchesFilter = true;
    if (currentReportSquadFilter === '116') matchesFilter = (rowSquad === '116');
    else if (currentReportSquadFilter === '115') matchesFilter = (rowSquad === '115');
    else if (currentReportSquadFilter === 'evaluated') matchesFilter = isEvaluated;

    var matchesSearch = !query || text.includes(query);

    if (matchesFilter && matchesSearch) {
      r.style.display = '';
      visibleCount++;
    } else {
      r.style.display = 'none';
    }
  });

  var label = document.getElementById('reportCountLabel');
  if (label) {
    label.textContent = 'Showing ' + visibleCount + ' candidate record(s)';
  }
}
</script>
<%- include('../partials/foot') %>
