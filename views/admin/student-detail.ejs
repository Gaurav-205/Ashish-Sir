<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div><h1><%= s.student.name %></h1>
    <p class="sub"><%= s.student.email %><%= s.student.roll_no ? ' · ' + s.student.roll_no : '' %><%= s.student.branch ? ' · ' + s.student.branch : '' %></p></div>
  <a class="btn" href="/admin/students">← All students</a>
</div>

<div class="grid two">
  <div class="card"><div class="card-head"><h2>Interviews</h2></div><div class="card-body">
    <% ['technical','hr'].forEach(function(t){ const iv = s[t]; %>
      <div style="margin-bottom:16px">
        <span class="pill p-<%= t %>"><%= h.titleCase(t) %></span>
        <% if (!iv) { %><span class="faint"> — not booked yet</span>
        <% } else { %>
          <span class="pill p-<%= iv.status %>"><%= iv.status %></span>
          <div class="faint" style="margin-top:5px"><%= h.fmtSlot(iv) %> · <%= iv.mentor_name %> · <%= iv.mode %><%= iv.location ? ' · ' + iv.location : '' %></div>
          <% if (iv.eval_id) { %>
            <div style="margin-top:7px">
              <% RUBRIC[t].criteria.forEach(function(c){ %>
                <span class="pill p-muted"><%= c.label %>: <%= iv[c.key] %>/<%= c.max %></span>
              <% }); %>
              <strong> = <%= iv.score %>/<%= RUBRIC[t].total %></strong>
            </div>
            <% if (iv.feedback) { %><p class="faint" style="margin-top:7px">“<%= iv.feedback %>”</p><% } %>
          <% } else if (iv.status === 'completed') { %>
            <div class="faint" style="margin-top:5px">Awaiting mentor evaluation.</div>
          <% } %>
        <% } %>
      </div>
    <% }); %>
    <% if (s.allEvaluated) { %>
      <div class="note" style="margin:0">Final: <strong><%= s.total %>/<%= GRAND_TOTAL %></strong> (<%= s.percent %>%) —
        <%= grade(s.percent).label %></div>
    <% } %>
  </div></div>

  <div class="card"><div class="card-head"><h2>Edit details</h2></div><div class="card-body">
    <form method="post" action="/admin/students/<%= s.student.id %>/update">
      <div class="row">
        <div class="field"><label>Name</label><input name="name" value="<%= s.student.name %>" required></div>
        <div class="field"><label>Roll no</label><input name="roll_no" value="<%= s.student.roll_no || '' %>"></div>
        <div class="field"><label>Branch</label><input name="branch" value="<%= s.student.branch || '' %>"></div>
        <div class="field"><label>Phone</label><input name="phone" value="<%= s.student.phone || '' %>"></div>
      </div>
      <div class="field"><label>Resume link</label><input type="url" name="resume_url" value="<%= s.student.resume_url || '' %>"></div>
      <label class="check"><input type="checkbox" name="active" value="1" <%= s.student.active ? 'checked' : '' %>> Account active</label>
      <button class="btn primary">Save changes</button>
    </form>
    <hr style="border:none;border-top:1px solid var(--line);margin:18px 0">
    <form method="post" action="/admin/students/<%= s.student.id %>/reset-password" class="btn-row">
      <input name="password" placeholder="New password" minlength="6" required style="max-width:220px">
      <button class="btn">Reset password</button>
    </form>
  </div></div>
</div>
<%- include('../partials/foot') %>
