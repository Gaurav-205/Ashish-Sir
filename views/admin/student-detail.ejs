<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Candidate Record · Profile &amp; Interview History
    </div>
    <h1><%= s.student.name %></h1>
    <p class="sub"><%= s.student.email %><%= s.student.roll_no ? ' · Roll No: ' + s.student.roll_no : '' %><%= s.student.branch ? ' · Branch: ' + s.student.branch : '' %></p>
  </div>
  <div class="btn-row">
    <% if (s.student.resume_url) { %>
      <a class="btn sm" href="<%= s.student.resume_url %>" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:6px">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
        View Resume Link
      </a>
    <% } %>
    <a class="btn sm" href="/admin/students">← All students</a>
  </div>
</div>

<div class="grid two">
  <div class="card">
    <div class="card-head"><h2>Interviews</h2></div>
    <div class="card-body tight">
      <div class="table-scroll"><table>
        <thead>
          <tr>
            <th>Type</th>
            <th>Date</th>
            <th>Time</th>
            <th>Mentor Name</th>
            <th>Status / Score</th>
          </tr>
        </thead>
        <tbody>
        <% ['technical','hr'].forEach(function(t){ const iv = s[t]; %>
          <tr>
            <td><span class="pill p-<%= t %>"><%= h.titleCase(t) %></span></td>
            <td><%= iv ? h.fmtDate(iv.slot_date) : '—' %></td>
            <td><%= iv ? h.fmtTime(iv.start_time) + ' – ' + h.fmtTime(iv.end_time) : '—' %></td>
            <td>
              <% if (iv) { %>
                <%= iv.mentor_name %>
                <% if (iv.location) { %><br><span class="faint"><%- h.linkify ? h.linkify(iv.location) : iv.location %></span><% } %>
              <% } else { %>
                <span class="faint">—</span>
              <% } %>
            </td>
            <td>
              <% if (!iv) { %>
                <span class="pill p-cancelled">Not Booked</span>
              <% } else { %>
                <span class="pill p-<%= iv.status %>"><%= iv.status %></span>
                <% if (iv.eval_id) { %>
                  <br><strong><%= iv.score %>/<%= RUBRIC[t].total %></strong>
                <% } %>
              <% } %>
            </td>
          </tr>
          <% if (iv && (iv.eval_id || iv.feedback)) { %>
            <tr>
              <td colspan="5" class="faint" style="background:var(--surface-hover);padding:8px 16px">
                <% if (iv.eval_id) { %>
                  <% RUBRIC[t].criteria.forEach(function(c){ %>
                    <span class="pill p-muted" style="margin-right:6px"><%= c.label %>: <%= iv[c.key] %>/<%= c.max %></span>
                  <% }); %>
                <% } %>
                <% if (iv.feedback) { %> <em>“<%= iv.feedback %>”</em><% } %>
              </td>
            </tr>
          <% } %>
        <% }); %>
        </tbody>
      </table></div>
      <% if (s.allEvaluated) { %>
        <div class="note" style="margin:16px 20px">Final: <strong><%= s.total %>/<%= GRAND_TOTAL %></strong> (<%= s.percent %>%) —
          <%= grade(s.percent).label %></div>
      <% } %>
    </div>
  </div>

  <div class="card"><div class="card-head"><h2>Edit details</h2></div><div class="card-body">
    <form method="post" action="/admin/students/<%= s.student.id %>/update">
      <div class="row">
        <div class="field"><label>Name</label><input name="name" value="<%= s.student.name %>" required></div>
        <div class="field"><label>Roll no</label><input name="roll_no" value="<%= s.student.roll_no || '' %>"></div>
        <div class="field"><label>Branch</label><input name="branch" value="<%= s.student.branch || '' %>"></div>
        <div class="field"><label>Phone</label><input name="phone" value="<%= s.student.phone || '' %>"></div>
      </div>
      <div class="field">
        <label>Resume link</label>
        <input type="url" name="resume_url" value="<%= s.student.resume_url || '' %>">
        <% if (s.student.resume_url) { %>
          <div style="margin-top:6px"><a class="btn sm" href="<%= s.student.resume_url %>" target="_blank" rel="noopener noreferrer">Open resume ↗</a></div>
        <% } %>
      </div>
      <label class="check"><input type="checkbox" name="active" value="1" <%= s.student.active ? 'checked' : '' %>> Account active</label>
      <button class="btn primary">Save changes</button>
    </form>
    <hr style="border:none;border-top:1px solid var(--line);margin:18px 0">
    <form method="post" action="/admin/students/<%= s.student.id %>/reset-password" class="btn-row">
      <input name="password" placeholder="New password" minlength="6" required style="max-width:220px">
      <button class="btn">Reset password</button>
    </form>
  </div></div>
