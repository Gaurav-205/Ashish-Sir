<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Platform Directory · Verified Evaluators
    </div>
    <h1>Mentors directory</h1>
    <p class="sub">Browse verified mentors across Technical and HR domains and explore their scheduled calendar slots.</p>
  </div>
  <div class="btn-row">
    <a class="btn primary" href="/student/slots?type=technical">Browse Technical slots</a>
    <a class="btn" href="/student/slots?type=hr">Browse HR slots</a>
  </div>
</div>

<div class="search-toolbar" style="margin-bottom:20px">
  <div class="filter-chips">
    <button type="button" class="filter-chip active" onclick="filterMentors('all', this)">All Mentors (<%= mentors.length %>)</button>
    <button type="button" class="filter-chip" onclick="filterMentors('technical', this)">Technical Mentors</button>
    <button type="button" class="filter-chip" onclick="filterMentors('hr', this)">HR Mentors</button>
  </div>
</div>

<div class="grid mentors-grid" id="mentorsGrid">
<% mentors.forEach(function(m){ %>
  <div class="card mentor-card" data-tech="<%= m.can_technical ? '1' : '0' %>" data-hr="<%= m.can_hr ? '1' : '0' %>">
    <div class="card-head">
      <div class="mentor-info">
        <% const mName = (m && m.name) ? String(m.name).trim() : ''; %>
        <% const mInitials = mName ? mName.split(/\s+/).map(w => w[0] || '').slice(0, 2).join('').toUpperCase() : '?'; %>
        <span class="avatar" style="width:40px;height:40px;font-size:13px"><%= mInitials %></span>
        <div class="mentor-meta">
          <h2 title="<%= m.name %>"><%= m.name %></h2>
          <span class="faint" title="<%= m.email %>"><%= m.email %></span>
        </div>
      </div>
      <div class="mentor-badges">
        <% if (m.can_technical) { %><span class="pill p-technical">Technical</span><% } %>
        <% if (m.can_hr) { %><span class="pill p-hr">HR</span><% } %>
      </div>
    </div>
    <div class="card-body">
      <div class="stats" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 18px;">
        <div class="stat" style="padding:10px 14px">
          <div class="n" style="font-size:18px"><%= m.total_open_slots %></div>
          <div class="l">Open slots</div>
        </div>
        <div class="stat" style="padding:10px 14px">
          <div class="n" style="font-size:18px"><%= m.tech_open_slots %></div>
          <div class="l">Tech slots</div>
        </div>
        <div class="stat" style="padding:10px 14px">
          <div class="n" style="font-size:18px"><%= m.hr_open_slots %></div>
          <div class="l">HR slots</div>
        </div>
      </div>

      <div class="btn-row">
        <% if (m.can_technical && m.tech_open_slots > 0) { %>
          <a class="btn sm primary" href="/student/slots?type=technical&mentor=<%= m.id %>">
            Book Technical slot (<%= m.tech_open_slots %> open) →
          </a>
        <% } %>
        <% if (m.can_hr && m.hr_open_slots > 0) { %>
          <a class="btn sm <%= (!m.can_technical || m.tech_open_slots === 0) ? 'primary' : '' %>" href="/student/slots?type=hr&mentor=<%= m.id %>">
            Book HR slot (<%= m.hr_open_slots %> open) →
          </a>
        <% } %>
        <% if (m.total_open_slots === 0) { %>
          <span class="faint" style="font-size:12px;padding:6px 0">No open slots currently scheduled. Check back soon.</span>
        <% } %>
      </div>
    </div>
  </div>
<% }); %>
<% if (!mentors.length) { %>
  <div class="card" style="grid-column: 1 / -1;"><div class="card-body empty">No verified mentors found.</div></div>
<% } %>
</div>
<script>
function filterMentors(domain, btn) {
  document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
  if (btn) btn.classList.add('active');
  const cards = document.querySelectorAll('.mentor-card');
  cards.forEach(c => {
    if (domain === 'all') {
      c.style.display = '';
    } else if (domain === 'technical') {
      c.style.display = c.getAttribute('data-tech') === '1' ? '' : 'none';
    } else if (domain === 'hr') {
      c.style.display = c.getAttribute('data-hr') === '1' ? '' : 'none';
    }
  });
}
</script>
<%- include('../partials/foot') %>
