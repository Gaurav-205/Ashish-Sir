<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Student Workspace · Cohort 2025–26<%= s.student.squad ? ' · Squad ' + s.student.squad : '' %>
    </div>
    <h1>Hello, <%= (s.student.name || '').trim().split(/\s+/)[0] || 'Student' %></h1>
    <p class="sub">Weekly Interview Cycle: <strong><%= (s.currentWeek && s.currentWeek.label) ? s.currentWeek.label : 'This Week' %></strong> · Complete your mandatory <strong>Technical (30 marks)</strong> and <strong>HR (20 marks)</strong> mock sessions.</p>
  </div>
  <% if (s.allEvaluated) { %>
    <a class="btn primary" href="/student/results">View Full Scorecard &amp; Results →</a>
  <% } else { %>
    <a class="btn" href="/student/mentors">Browse Mentors Directory →</a>
  <% } %>
</div>

<% if (!s.student.resume_url) { %>
<div class="note" style="margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fffbeb;border-color:#fde68a">
  <div style="display:flex;align-items:center;gap:10px">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span><strong>Resume link missing:</strong> Add your Google Drive or portfolio CV link so mentors can review it before your session.</span>
  </div>
  <a class="btn sm" href="/profile#resume" style="white-space:nowrap;background:#ffffff">Add Resume Link →</a>
</div>
<% } %>

<div class="milestone-grid">
  <div class="milestone-step <%= s.student.resume_url ? 'done' : 'active' %>">
    <div class="step-num"><%= s.student.resume_url ? '✓' : '1' %></div>
    <div>
      <div style="font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:var(--slate);font-weight:700">Milestone 01</div>
      <strong>Profile &amp; Resume</strong>
      <div class="faint" style="font-size:12px"><%= s.student.resume_url ? 'CV attached' : 'Action needed' %></div>
    </div>
  </div>
  <div class="milestone-step <%= s.allBooked ? 'done' : (s.student.resume_url ? 'active' : '') %>">
    <div class="step-num"><%= s.allBooked ? '✓' : '2' %></div>
    <div>
      <div style="font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:var(--slate);font-weight:700">Milestone 02</div>
      <strong>Book Both Slots</strong>
      <div class="faint" style="font-size:12px"><%= s.bookedCount %> of 2 booked</div>
    </div>
  </div>
  <div class="milestone-step <%= s.attendedCount === 2 ? 'done' : (s.allBooked ? 'active' : '') %>">
    <div class="step-num"><%= s.attendedCount === 2 ? '✓' : '3' %></div>
    <div>
      <div style="font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:var(--slate);font-weight:700">Milestone 03</div>
      <strong>Attend Interviews</strong>
      <div class="faint" style="font-size:12px"><%= s.attendedCount %> of 2 attended</div>
    </div>
  </div>
  <div class="milestone-step <%= s.allEvaluated ? 'done' : (s.completedCount > 0 ? 'active' : '') %>">
    <div class="step-num"><%= s.allEvaluated ? '✓' : '4' %></div>
    <div>
      <div style="font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:var(--slate);font-weight:700">Milestone 04</div>
      <strong>Scores &amp; Feedback</strong>
      <div class="faint" style="font-size:12px"><%= s.evaluatedCount %> of 2 submitted</div>
    </div>
  </div>
</div>

<div class="grid two">
<% ['technical','hr'].forEach(function(t){ const iv = s[t]; %>
  <div class="card">
    <div class="card-head">
      <div style="display:flex;align-items:center;gap:8px">
        <span class="pill p-<%= t %>"><%= h.titleCase(t) %></span>
        <h2 style="margin:0"><%= h.titleCase(t) %> Interview</h2>
      </div>
      <span class="mono faint">Max <%= RUBRIC[t].total %> marks</span>
    </div>
    <div class="card-body">
      <% if (!iv) { %>
        <p class="muted" style="margin-bottom:18px">
          You have not scheduled this interview yet. <%= open[t] %> slot(s) currently open on the platform.
        </p>
        <a class="btn primary sm" href="/student/slots?type=<%= t %>">
          Select &amp; Book <%= h.titleCase(t) %> Slot →
        </a>
      <% } else { %>
        <div style="margin-bottom:16px">
          <p style="margin-bottom:6px">
            <strong style="font-size:15px"><%= h.fmtSlot(iv) %></strong>
          </p>
          <p class="muted" style="margin-bottom:4px;font-size:13px">
            Assigned Mentor: <strong><%= iv.mentor_name %></strong> (<%= iv.mentor_email %>)
          </p>
          <p class="muted" style="margin-bottom:6px;font-size:13px">
            Mode: <%= iv.mode %><% if (iv.location) { %> · <%- h.linkify(iv.location) %><% } %>
          </p>
          <% if (iv.location && iv.status === 'booked' && !h.isPast(iv)) { %>
            <div style="margin-top:8px;margin-bottom:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
              <a class="btn sm primary" href="<%= iv.location %>" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:6px">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                Join Google Meet ↗
              </a>
              <a class="btn sm" href="https://meet.google.com/new" target="_blank" rel="noopener noreferrer" style="font-size:11px" title="Start an instant Google Meet room">
                Start Instant Google Meet ↗
              </a>
            </div>
          <% } %>
        </div>

        <div style="display:flex;gap:6px;align-items:center;margin-bottom:14px;flex-wrap:wrap">
          <span class="pill p-<%= iv.status %>"><%= iv.status %></span>
          <% if (iv.attendance === 'attended') { %>
            <span class="pill p-completed">✓ Marked Present (Attended)</span>
          <% } else if (iv.attendance === 'absent') { %>
            <span class="pill p-cancelled">✗ Marked Absent</span>
          <% } else if (h.isPast(iv)) { %>
            <span class="pill" style="background:#fef3c7;color:#92400e;border:1px solid #fde68a;font-weight:600">Slot Passed · Awaiting Mentor Attendance</span>
          <% } %>
          <% if (iv.status === 'completed' && !iv.eval_id && iv.attendance === 'attended') { %>
            <span class="faint">— evaluation in progress by mentor.</span>
          <% } %>
        </div>

        <% if (iv.eval_id) { %>
          <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--line-soft)">
            <div class="big-score"><%= iv.score %><small>/<%= RUBRIC[t].total %></small></div>
            <div class="bar"><span style="width:<%= (iv.score / RUBRIC[t].total * 100).toFixed(0) %>%"></span></div>
            <p style="margin-top:12px;margin-bottom:0"><a href="/student/results">View detailed breakdown &amp; feedback →</a></p>
          </div>
        <% } else if (iv.status === 'booked' && !h.isPast(iv)) { %>
          <form method="post" action="/student/cancel/<%= iv.id %>"
                onsubmit="return confirm('Cancel this booking? You will need to select another slot.')" style="margin-top:16px">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn sm danger">Cancel Booking</button>
          </form>
        <% } %>

        <% if ((iv.status === 'completed' || iv.attendance === 'attended') && iv.attendance !== 'absent') { %>
          <div style="margin-top:16px;padding-top:14px;border-top:1px dashed var(--line-soft)">
            <div style="font-weight:600;font-size:13px;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between">
              <span>Student Feedback for Mentor (<%= iv.mentor_name %>)</span>
              <% if (iv.student_feedback_id) { %>
                <span class="pill p-completed">✓ Feedback Submitted</span>
              <% } %>
            </div>

            <% if (iv.student_feedback_id) { %>
              <div style="background:var(--surface-hover);padding:10px;border-radius:6px;font-size:12px" class="muted">
                <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:4px">
                  <span>Experience: <strong><%= iv.feedback_satisfaction %>/5 ⭐</strong></span>
                  <span>Structured: <strong><%= iv.feedback_structured === 1 ? 'Yes' : 'No' %></strong></span>
                  <% if (iv.type === 'hr') { %>
                    <span>HR Relevant: <strong><%= iv.feedback_hr_relevant === 1 ? 'Yes' : 'No' %></strong></span>
                  <% } %>
                </div>
                <details style="margin-top:6px">
                  <summary style="cursor:pointer;color:var(--action-blue)">Edit Feedback</summary>
            <% } %>

            <form method="post" action="/student/feedback/<%= iv.id %>" style="margin-top:8px;background:var(--surface-hover);padding:12px;border-radius:8px;border:1px solid var(--line-soft)">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              
              <div style="margin-bottom:10px">
                <label style="display:block;font-weight:600;margin-bottom:4px;font-size:12px">
                  1. How satisfied are you with your overall interview experience with this mentor?
                </label>
                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                  <% [5, 4, 3, 2, 1].forEach(function(val){ %>
                    <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                      <input type="radio" name="satisfaction" value="<%= val %>" <%= (iv.student_feedback_id ? iv.feedback_satisfaction === val : val === 5) ? 'checked' : '' %> required>
                      <%= val === 5 ? '5 - Very Satisfied' : val === 4 ? '4 - Satisfied' : val === 3 ? '3 - Neutral' : val === 2 ? '2 - Dissatisfied' : '1 - Very Dissatisfied' %>
                    </label>
                  <% }); %>
                </div>
              </div>

              <div style="margin-bottom:10px">
                <label style="display:block;font-weight:600;margin-bottom:4px;font-size:12px">
                  2. Did the interview feel structured and well organized?
                </label>
                <div style="display:flex;gap:14px;align-items:center">
                  <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                    <input type="radio" name="structured" value="1" <%= (iv.student_feedback_id ? iv.feedback_structured === 1 : true) ? 'checked' : '' %> required> Yes
                  </label>
                  <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                    <input type="radio" name="structured" value="0" <%= iv.feedback_structured === 0 ? 'checked' : '' %> required> No
                  </label>
                </div>
              </div>

              <% if (iv.type === 'hr') { %>
                <div style="margin-bottom:10px">
                  <label style="display:block;font-weight:600;margin-bottom:4px;font-size:12px">
                    3. Were the HR questions relevant to placement/job preparation?
                  </label>
                  <div style="display:flex;gap:14px;align-items:center">
                    <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                      <input type="radio" name="hr_relevant" value="1" <%= (iv.student_feedback_id ? iv.feedback_hr_relevant === 1 : true) ? 'checked' : '' %> required> Yes
                    </label>
                    <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                      <input type="radio" name="hr_relevant" value="0" <%= iv.feedback_hr_relevant === 0 ? 'checked' : '' %> required> No
                    </label>
                  </div>
                </div>
              <% } %>

              <div style="margin-bottom:10px">
                <textarea name="feedback_text" rows="2" style="width:100%;font-size:12px" placeholder="Additional comments for mentor (optional)..."><%= iv.feedback_comments || '' %></textarea>
              </div>

              <button class="btn sm primary"><%= iv.student_feedback_id ? 'Update Feedback' : 'Submit Feedback' %></button>
            </form>

            <% if (iv.student_feedback_id) { %>
                </details>
              </div>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
<% }); %>
</div>

<div class="note" style="margin-top:24px;display:flex;align-items:center;gap:10px">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;color:var(--action-blue)">
    <circle cx="12" cy="12" r="10"></circle>
    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
  </svg>
  <div>
    Want to view mentor backgrounds or slot availability by mentor? <a href="/student/mentors">Explore the Mentors Directory →</a>
  </div>
</div>
<%- include('../partials/foot') %>
