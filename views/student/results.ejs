<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Official Scorecard · Cohort Evaluation Report
    </div>
    <h1>Performance results &amp; scorecard</h1>
    <p class="sub">Candidate: <strong><%= s.student.name %></strong> · Roll No: <strong><%= s.student.roll_no || '—' %></strong> · Branch: <strong><%= s.student.branch || '—' %></strong></p>
  </div>
  <% if (s.allEvaluated) { %>
    <button class="btn sm primary" onclick="window.print()" style="display:inline-flex;align-items:center;gap:8px">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 6 2 18 2 18 9"></polyline>
        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
        <rect x="6" y="14" width="12" height="8"></rect>
      </svg>
      Print scorecard / Save PDF
    </button>
  <% } %>
</div>

<!-- TOP SECTION: 2 CARDS FOR TECHNICAL AND NON-TECHNICAL (HR) SCORES THIS WEEK -->
<div class="grid two" style="margin-bottom:24px">
  <% ['technical','hr'].forEach(function(t){ const iv = s[t]; %>
    <div class="card">
      <div class="card-head">
        <div style="display:flex;align-items:center;gap:8px">
          <span class="pill p-<%= t %>"><%= t === 'hr' ? 'HR' : 'Technical' %></span>
          <h2 style="margin:0"><%= t === 'hr' ? 'HR' : 'Technical' %> Interview (This Week)</h2>
        </div>
        <% if (iv && iv.eval_id) { %>
          <strong style="font-family:var(--font-display);font-size:16px"><%= iv.score %> / <%= RUBRIC[t].total %></strong>
        <% } %>
      </div>
      <div class="card-body">
        <% if (!iv) { %>
          <div style="margin-bottom:12px">
            <div class="big-score" style="color:var(--muted)">—<small>/<%= RUBRIC[t].total %></small></div>
            <p class="muted" style="margin-top:6px">Not scheduled for this week cycle. <a href="/student/slots?type=<%= t %>">Book a slot →</a></p>
          </div>
        <% } else { %>
          <div style="margin-bottom:14px">
            <% if (iv.eval_id) { %>
              <div class="big-score"><%= iv.score %><small>/<%= RUBRIC[t].total %></small></div>
              <div class="bar" style="margin-top:6px"><span style="width:<%= (iv.score / RUBRIC[t].total * 100).toFixed(0) %>%"></span></div>
            <% } else { %>
              <div class="big-score" style="color:var(--muted)">—<small>/<%= RUBRIC[t].total %></small></div>
              <div class="faint" style="margin-top:4px">
                <% if (iv.attendance === 'absent') { %>
                  Candidate marked absent / no-show
                <% } else if (iv.status === 'completed') { %>
                  Evaluation in progress by mentor
                <% } else { %>
                  Upcoming scheduled session
                <% } %>
              </div>
            <% } %>
          </div>

          <div style="padding-top:12px;border-top:1px solid var(--line-soft)">
            <p class="faint" style="margin-bottom:4px">
              <strong><%= h.fmtSlot(iv) %></strong>
            </p>
            <p class="muted" style="margin-bottom:4px;font-size:13px">
              Assigned Mentor: <strong><%= iv.mentor_name %></strong>
            </p>
            <p class="muted" style="margin-bottom:8px;font-size:13px">
              Mode &amp; Location: <%= iv.mode %><% if (iv.location) { %> · <%- h.linkify(iv.location) %><% } %>
            </p>
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
              <span class="pill p-<%= iv.status %>"><%= iv.status %></span>
              <% if (iv.attendance === 'attended') { %>
                <span class="pill p-completed">Attended</span>
              <% } else if (iv.attendance === 'absent') { %>
                <span class="pill p-cancelled">Absent / No-Show</span>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% }); %>
</div>

<% if (s.allEvaluated) { %>
  <div class="score-hero-box">
    <div>
      <div style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#cbd5e1;margin-bottom:6px">Official Placement Evaluation</div>
      <div class="score-hero-val"><%= s.total %><span style="font-size:26px;color:#94a3b8">/<%= GRAND_TOTAL %></span></div>
      <div style="margin-top:8px">
        <span class="pill" style="background:#ffffff;color:#17171c;font-weight:700;font-size:13px"><%= grade(s.percent).label %> · <%= s.percent %>% Aggregate</span>
      </div>
    </div>
    <div style="display:flex;gap:32px;flex-wrap:wrap">
      <div>
        <div style="font-size:12px;color:#94a3b8;margin-bottom:4px">Technical Mock Score</div>
        <div style="font-size:24px;font-weight:700;font-family:var(--font-display)"><%= s.techScore %> <span style="font-size:14px;color:#94a3b8">/ <%= RUBRIC.technical.total %></span></div>
        <div class="bar" style="background:rgba(255,255,255,0.15);width:140px;margin-top:6px"><span style="background:#38bdf8;width:<%= (s.techScore / RUBRIC.technical.total * 100).toFixed(0) %>%"></span></div>
      </div>
      <div>
        <div style="font-size:12px;color:#94a3b8;margin-bottom:4px">HR Mock Score</div>
        <div style="font-size:24px;font-weight:700;font-family:var(--font-display)"><%= s.hrScore %> <span style="font-size:14px;color:#94a3b8">/ <%= RUBRIC.hr.total %></span></div>
        <div class="bar" style="background:rgba(255,255,255,0.15);width:140px;margin-top:6px"><span style="background:#c084fc;width:<%= (s.hrScore / RUBRIC.hr.total * 100).toFixed(0) %>%"></span></div>
      </div>
    </div>
  </div>
<% } %>

<!-- SECOND SECTION: REMAINING HISTORY BY RECENCY -->
<div class="card" style="margin-bottom:24px">
  <div class="card-head">
    <h2>Interview History (Ordered by Recency)</h2>
    <span class="faint">All past and scheduled interviews ordered from newest to oldest</span>
  </div>
  <div class="card-body tight">
    <% const historyList = (s.history && s.history.length) ? s.history : (s.technical || s.hr ? [s.technical, s.hr].filter(Boolean) : []); %>
    <% if (!historyList.length) { %>
      <div class="empty">No interview records found.</div>
    <% } else { %>
      <div class="table-scroll"><table>
        <thead>
          <tr>
            <th>Date &amp; Time</th>
            <th>Type / Domain</th>
            <th>Mentor / Meeting Link</th>
            <th>Attendance &amp; Status</th>
            <th class="num">Score</th>
          </tr>
        </thead>
        <tbody>
        <% historyList.forEach(function(iv){ %>
          <tr>
            <td><%= h.fmtDate(iv.slot_date) %><br><span class="faint"><%= h.fmtTime(iv.start_time) %> – <%= h.fmtTime(iv.end_time) %></span></td>
            <td><span class="pill p-<%= iv.type %>"><%= iv.type === 'hr' ? 'HR' : 'Technical' %></span></td>
            <td>
              <strong><%= iv.mentor_name %></strong>
              <% if (iv.location) { %><br><span class="faint"><%- h.linkify(iv.location) %></span><% } %>
            </td>
            <td>
              <span class="pill p-<%= iv.status %>"><%= iv.status %></span>
              <% if (iv.attendance === 'attended') { %>
                <span class="pill p-completed">Attended</span>
              <% } else if (iv.attendance === 'absent') { %>
                <span class="pill p-cancelled">Absent</span>
              <% } %>
            </td>
            <td class="num">
              <% if (iv.eval_id) { %>
                <strong style="font-family:var(--font-display)"><%= iv.score %></strong><span class="faint">/<%= RUBRIC[iv.type].total %></span>
              <% } else { %>
                <span class="faint">—</span>
              <% } %>
            </td>
          </tr>
          <% if (iv.eval_id || iv.feedback || ((iv.status === 'completed' || iv.attendance === 'attended') && iv.attendance !== 'absent')) { %>
            <tr>
              <td colspan="5" style="background:var(--surface-hover);padding:12px 16px;border-bottom:1px solid var(--line-soft)">
                <% if (iv.eval_id) { %>
                  <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px">
                    <% RUBRIC[iv.type].criteria.forEach(function(c){ %>
                      <span class="pill p-muted"><%= c.label %>: <strong><%= iv[c.key] %></strong>/<%= c.max %></span>
                    <% }); %>
                  </div>
                <% } %>
                <% if (iv.feedback) { %>
                  <p class="muted" style="margin:4px 0 8px;font-style:italic;font-size:13px">
                    Mentor Evaluation Feedback: “<%= iv.feedback %>”
                  </p>
                <% } %>

                <% if ((iv.status === 'completed' || iv.attendance === 'attended') && iv.attendance !== 'absent') { %>
                  <div style="margin-top:10px;padding-top:10px;border-top:1px dashed var(--line-soft)">
                    <div style="font-weight:600;font-size:13px;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between">
                      <span>Student Feedback on Mentor (<%= iv.mentor_name %>)</span>
                      <% if (iv.student_feedback_id) { %>
                        <span class="pill p-completed">✓ Feedback Submitted</span>
                      <% } %>
                    </div>

                    <% if (iv.student_feedback_id) { %>
                      <div style="background:var(--surface);padding:10px;border-radius:6px;font-size:12px;margin-bottom:6px" class="muted">
                        <div style="display:flex;gap:12px;flex-wrap:wrap">
                          <span>Overall Experience: <strong><%= iv.feedback_satisfaction %>/5 ⭐</strong></span>
                          <span>Structured: <strong><%= iv.feedback_structured === 1 ? 'Yes' : 'No' %></strong></span>
                          <% if (iv.type === 'hr') { %>
                            <span>HR Questions Relevant: <strong><%= iv.feedback_hr_relevant === 1 ? 'Yes' : 'No' %></strong></span>
                          <% } %>
                        </div>
                        <% if (iv.feedback_comments) { %>
                          <div style="margin-top:4px;font-style:italic">“<%= iv.feedback_comments %>”</div>
                        <% } %>
                        <details style="margin-top:6px">
                          <summary style="cursor:pointer;color:var(--action-blue)">Edit Feedback</summary>
                    <% } %>

                    <form method="post" action="/student/feedback/<%= iv.id %>" style="margin-top:6px;background:var(--surface);padding:12px;border-radius:8px;border:1px solid var(--line-soft)">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      
                      <div style="margin-bottom:10px">
                        <label style="display:block;font-weight:600;margin-bottom:4px;font-size:12px">
                          1. How satisfied are you with your overall interview experience with this mentor?
                        </label>
                        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                          <% [5, 4, 3, 2, 1].forEach(function(val){ %>
                            <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                              <input type="radio" name="satisfaction" value="<%= val %>" <%= iv.feedback_satisfaction === val ? 'checked' : (val === 5 ? 'checked' : '') %> required>
                              <%= val === 5 ? '5 - Very Satisfied' : val === 4 ? '4 - Satisfied' : val === 3 ? '3 - Neutral' : val === 2 ? '2 - Dissatisfied' : '1 - Very Dissatisfied' %>
                            </label>
                          <% }); %>
                        </div>
                      </div>

                      <div style="margin-bottom:10px">
                        <label style="display:block;font-weight:600;margin-bottom:4px;font-size:12px">
                          2. Did the interview feel structured and well organized?
                        </label>
                        <div style="display:flex;gap:14px;align-items:center">
                          <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                            <input type="radio" name="structured" value="1" <%= iv.feedback_structured === 1 ? 'checked' : (iv.feedback_structured !== 0 ? 'checked' : '') %> required> Yes
                          </label>
                          <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                            <input type="radio" name="structured" value="0" <%= iv.feedback_structured === 0 ? 'checked' : '' %> required> No
                          </label>
                        </div>
                      </div>

                      <% if (iv.type === 'hr') { %>
                        <div style="margin-bottom:10px">
                          <label style="display:block;font-weight:600;margin-bottom:4px;font-size:12px">
                            3. Were the HR questions relevant to placement/job preparation?
                          </label>
                          <div style="display:flex;gap:14px;align-items:center">
                            <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                              <input type="radio" name="hr_relevant" value="1" <%= iv.feedback_hr_relevant === 1 ? 'checked' : (iv.feedback_hr_relevant !== 0 ? 'checked' : '') %> required> Yes
                            </label>
                            <label style="font-size:12px;display:inline-flex;align-items:center;gap:3px;cursor:pointer">
                              <input type="radio" name="hr_relevant" value="0" <%= iv.feedback_hr_relevant === 0 ? 'checked' : '' %> required> No
                            </label>
                          </div>
                        </div>
                      <% } %>

                      <div style="margin-bottom:10px">
                        <textarea name="feedback_text" rows="2" style="width:100%;font-size:12px" placeholder="Additional comments for mentor (optional)..."><%= iv.feedback_comments || '' %></textarea>
                      </div>

                      <button class="btn sm primary"><%= iv.student_feedback_id ? 'Update Feedback' : 'Submit Feedback' %></button>
                    </form>

                    <% if (iv.student_feedback_id) { %>
                        </details>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </td>
            </tr>
          <% } %>
        <% }); %>
        </tbody>
      </table></div>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
