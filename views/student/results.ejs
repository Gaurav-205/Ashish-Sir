<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Official Scorecard · Cohort Evaluation Report
    </div>
    <h1>Performance results</h1>
    <p class="sub">Candidate: <strong><%= s.student.name %></strong> · Roll No: <strong><%= s.student.roll_no || '—' %></strong> · Branch: <strong><%= s.student.branch || '—' %></strong></p>
  </div>
  <% if (s.allEvaluated) { %>
    <button class="btn sm primary" onclick="window.print()" style="display:inline-flex;align-items:center;gap:8px">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 6 2 18 2 18 9"></polyline>
        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
        <rect x="6" y="14" width="12" height="8"></rect>
      </svg>
      Print scorecard / Save PDF
    </button>
  <% } %>
</div>

<% if (!s.allEvaluated) { %>
  <div class="note" style="display:flex;align-items:center;gap:10px">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;color:var(--action-blue)">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="16" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12.01" y2="8"></line>
    </svg>
    <div>
      Your final aggregated scorecard will appear here once <strong>both Technical and HR interviews</strong> are conducted and evaluated by mentors.
      <br>Current completion status: <strong><%= s.evaluatedCount %> of 2 evaluations submitted</strong>.
    </div>
  </div>
<% } else { %>
  <div class="card" style="margin-bottom:24px;background:var(--surface)">
    <div class="card-body">
      <div class="grid three">
        <div>
          <div class="l">Technical Interview</div>
          <div class="big-score"><%= s.techScore %><small>/<%= RUBRIC.technical.total %></small></div>
          <div class="bar"><span style="width:<%= (s.techScore / RUBRIC.technical.total * 100).toFixed(0) %>%"></span></div>
        </div>
        <div>
          <div class="l">HR Interview</div>
          <div class="big-score"><%= s.hrScore %><small>/<%= RUBRIC.hr.total %></small></div>
          <div class="bar"><span style="width:<%= (s.hrScore / RUBRIC.hr.total * 100).toFixed(0) %>%"></span></div>
        </div>
        <div>
          <div class="l">Grand Aggregate Total</div>
          <div class="big-score"><%= s.total %><small>/<%= GRAND_TOTAL %></small></div>
          <div style="margin-top:8px">
            <span class="pill <%= grade(s.percent).cls %>"><%= grade(s.percent).label %> · <%= s.percent %>%</span>
          </div>
          <div class="bar"><span style="width:<%= s.percent %>%"></span></div>
        </div>
      </div>
    </div>
  </div>
<% } %>

<div class="grid two">
<% ['technical','hr'].forEach(function(t){ const iv = s[t]; %>
  <div class="card">
    <div class="card-head">
      <div style="display:flex;align-items:center;gap:8px">
        <span class="pill p-<%= t %>"><%= h.titleCase(t) %></span>
        <h2 style="margin:0"><%= h.titleCase(t) %> Interview</h2>
      </div>
      <% if (iv && iv.eval_id) { %>
        <strong style="font-family:var(--font-display);font-size:16px"><%= iv.score %> / <%= RUBRIC[t].total %></strong>
      <% } %>
    </div>
    <div class="card-body">
      <% if (!iv) { %>
        <p class="muted">Not booked yet. <a href="/student/slots?type=<%= t %>">Select an open slot →</a></p>
      <% } else { %>
        <div style="margin-bottom:14px">
          <p class="faint" style="margin-bottom:6px">
            <%= h.fmtSlot(iv) %> · Mentor: <strong><%= iv.mentor_name %></strong>
          </p>
          <div style="display:flex;gap:6px;align-items:center">
            <span class="pill p-<%= iv.status %>"><%= iv.status %></span>
            <% if (iv.attendance === 'attended') { %>
              <span class="pill p-completed">Attended</span>
            <% } else if (iv.attendance === 'absent') { %>
              <span class="pill p-cancelled">Absent / No-Show</span>
            <% } %>
          </div>
        </div>

        <% if (iv.eval_id) { %>
          <div class="table-scroll" style="margin-top:14px;border:1px solid var(--line-soft);border-radius:var(--radius-sm)">
            <table>
              <thead><tr><th>Evaluation Criterion</th><th class="num">Marks Awarded</th><th class="num">Max</th></tr></thead>
              <tbody>
              <% RUBRIC[t].criteria.forEach(function(c){ %>
                <tr>
                  <td><%= c.label %></td>
                  <td class="num"><strong><%= iv[c.key] %></strong></td>
                  <td class="num faint"><%= c.max %></td>
                </tr>
              <% }); %>
                <tr style="background:var(--surface-alt)">
                  <td><strong>Aggregate Score</strong></td>
                  <td class="num"><strong><%= iv.score %></strong></td>
                  <td class="num faint"><%= RUBRIC[t].total %></td>
                </tr>
              </tbody>
            </table>
          </div>
          <% if (iv.feedback) { %>
            <div style="margin-top:16px;background:var(--surface-alt);padding:14px 18px;border-radius:var(--radius-sm);border:1px solid var(--line-soft)">
              <div class="l" style="margin-bottom:4px">Mentor Qualitative Feedback</div>
              <p style="margin:0;font-style:italic;color:var(--ink)">“<%= iv.feedback %>”</p>
            </div>
          <% } %>
        <% } else { %>
          <p class="muted">Evaluation is pending mentor submission.</p>
        <% } %>
      <% } %>
    </div>
  </div>
<% }); %>
</div>
<%- include('../partials/foot') %>
