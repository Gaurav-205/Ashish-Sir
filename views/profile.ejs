<%- include('partials/head') %><%- include('partials/nav') %>
<div class="page-head"><div><h1>My profile</h1></div></div>
<div class="grid two">
  <div class="card">
    <div class="card-head"><h2>My details</h2></div>
    <div class="card-body">
      <form method="post" action="/profile/update">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label>Full name</label>
          <input name="name" value="<%= me.name %>" required>
        </div>
        <div class="field">
          <label>Email (read-only)</label>
          <input value="<%= me.email %>" disabled class="muted">
        </div>
        <div class="row">
          <div class="field">
            <label>Phone number</label>
            <input name="phone" value="<%= me.phone || '' %>" placeholder="+91 98765 43210">
          </div>
          <% if (me.role === 'student') { %>
            <div class="field">
              <label>Squad</label>
              <input name="squad" value="<%= me.squad || '' %>" placeholder="115 or 116">
            </div>
            <div class="field">
              <label>Branch / Specialization</label>
              <input name="branch" value="<%= me.branch || '' %>" placeholder="e.g. CSE, IT, ECE">
            </div>
          <% } %>
        </div>
        <% if (me.role === 'student') { %>
          <div class="field" id="resume">
            <label for="resume_url">Resume link (Google Drive / Notion / Portfolio)</label>
            <input id="resume_url" type="url" name="resume_url" value="<%= me.resume_url || '' %>" placeholder="https://drive.google.com/…">
          </div>
        <% } %>
        <p class="faint" style="margin-bottom:12px">
          Role: <strong><%= me.role %></strong>
          <% if (me.roll_no) { %> · Roll No: <strong><%= me.roll_no %></strong><% } %>
          <% if (me.squad) { %> · Squad: <strong><%= me.squad %></strong><% } %>
          <% if (me.role === 'mentor') { %>
            · Capabilities:
            <% if (me.can_technical) { %><span class="pill p-technical">Technical</span><% } %>
            <% if (me.can_hr) { %><span class="pill p-hr">HR</span><% } %>
          <% } %>
        </p>
        <button class="btn primary sm">Save profile details</button>
      </form>
    </div>
  </div>
  <div class="card" id="password">
    <div class="card-head"><h2>Change password</h2></div>
    <div class="card-body">
      <p class="hint" style="margin-bottom:14px">
        Choose a password only you know. Signing in elsewhere will be required again after you change it.
        Forgot the current one? <a href="/forgot-password">Reset it by email link</a>.
      </p>
      <% if (error) { %><div class="flash err"><%= error %></div><% } %>
      <% if (ok) { %><div class="flash ok"><%= ok %></div><% } %>
      <form method="post" action="/profile/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="pw-current">Current password</label><input id="pw-current" type="password" name="current" autocomplete="current-password" required></div>
        <div class="field"><label for="pw-next1">New password</label><input id="pw-next1" type="password" name="next1" autocomplete="new-password" placeholder="Minimum 6 characters" required minlength="6"></div>
        <div class="field"><label for="pw-next2">Confirm new password</label><input id="pw-next2" type="password" name="next2" autocomplete="new-password" placeholder="Re-enter new password" required minlength="6"></div>
        <button class="btn primary sm">Update password</button>
      </form>
    </div>
  </div>
</div>

<div class="card" style="margin-top:24px">
  <div class="card-head">
    <h2>Google Account &amp; Calendar Integration</h2>
    <% if (me.google_id) { %>
      <span class="pill p-completed">Connected</span>
    <% } else { %>
      <span class="pill p-muted">Not connected</span>
    <% } %>
  </div>
  <div class="card-body">
    <p class="muted">
      Connect your Google account to automatically sync your interview bookings, meeting links, and schedule updates directly to your Google Calendar.
    </p>
    <% if (me.google_id) { %>
      <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
        <form method="post" action="/profile/google/toggle-calendar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn sm <%= me.google_calendar_enabled ? 'primary' : '' %>">
            <%= me.google_calendar_enabled ? '✓ Google Calendar sync active' : 'Enable Calendar sync' %>
          </button>
        </form>
        <form method="post" action="/profile/google/disconnect" onsubmit="return confirm('Disconnect Google account and calendar sync?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn sm danger">Disconnect Google Account</button>
        </form>
      </div>
    <% } else { %>
      <a href="/auth/google?link=1" class="btn btn-google sm">
        <svg width="16" height="16" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        Connect Google Account &amp; Calendar
      </a>
      <% if (!googleConfigured) { %>
        <span class="hint" style="display:block;margin-top:8px">
          To enable live Google OAuth and Calendar access, set <code>GOOGLE_CLIENT_ID</code> and <code>GOOGLE_CLIENT_SECRET</code> in your environment.
        </span>
      <% } %>
    <% } %>
  </div>
</div>
<%- include('partials/foot') %>
