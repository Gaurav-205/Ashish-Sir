<%- include('partials/head') %>
<div class="login-page">
  <div class="login-card">
    <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:14px">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect width="24" height="24" rx="6" fill="#17171c"/>
        <path d="M7 12L10.5 15.5L17 8.5" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase">
        Account Recovery
      </span>
    </div>

    <h1>Forgot your password?</h1>
    <p class="sub">Enter the email address you sign in with and we will generate a single-use link to set a new password.</p>

    <% if (error) { %><div class="flash err"><%= error %></div><% } %>

    <% if (sent) { %>
      <div class="flash ok">
        If <strong><%= email %></strong> matches an active account, a reset link has been generated. Reset links expire in 1 hour and can be used once.
      </div>
      <% if (resetUrl) { %>
        <div class="note" style="margin-top:14px;word-break:break-all">
          <div class="mono" style="font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:var(--slate);margin-bottom:6px">
            No mail provider configured — link shown here
          </div>
          <a href="<%= resetUrl %>"><%= resetUrl %></a>
        </div>
      <% } else { %>
        <p class="hint" style="margin-top:12px">If you do not receive it, contact your placement cell administrator.</p>
      <% } %>
      <div class="btn-row" style="margin-top:18px">
        <a class="btn primary" href="/login">← Back to sign in</a>
      </div>
    <% } else { %>
      <form method="post" action="/forgot-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="email">Work / Academic Email</label>
          <input id="email" name="email" type="email" value="<%= email %>" autocomplete="username email"
                 placeholder="name@kalvium.com or student email" required autofocus>
        </div>
        <button class="btn primary" style="width:100%;justify-content:center;margin-top:6px;padding:12px 24px">
          Send me a reset link →
        </button>
      </form>
      <div class="demo-creds" style="text-align:center">
        <a href="/login">← Back to sign in</a>
      </div>
    <% } %>
  </div>
</div>
<%- include('partials/foot-plain') %>
