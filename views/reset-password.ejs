<%- include('partials/head') %>
<div class="login-page">
  <div class="login-card">
    <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:14px">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect width="24" height="24" rx="6" fill="#17171c"/>
        <path d="M7 12L10.5 15.5L17 8.5" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase">
        Account Recovery
      </span>
    </div>

    <h1>Choose a new password</h1>
    <% if (email) { %><p class="sub">Setting a new password for <strong><%= email %></strong>.</p><% } %>

    <% if (error) { %><div class="flash err"><%= error %></div><% } %>

    <% if (token) { %>
      <form method="post" action="/reset-password/<%= token %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="next1">New password</label>
          <input id="next1" name="next1" type="password" autocomplete="new-password"
                 placeholder="Minimum 6 characters" required minlength="6" autofocus>
        </div>
        <div class="field">
          <label for="next2">Confirm new password</label>
          <input id="next2" name="next2" type="password" autocomplete="new-password"
                 placeholder="Re-enter new password" required minlength="6">
        </div>
        <button class="btn primary" style="width:100%;justify-content:center;margin-top:6px;padding:12px 24px">
          Update password →
        </button>
      </form>
    <% } else { %>
      <div class="btn-row" style="margin-top:18px">
        <a class="btn primary" href="/forgot-password">Request a new link</a>
        <a class="btn" href="/login">Back to sign in</a>
      </div>
    <% } %>
  </div>
</div>
<%- include('partials/foot-plain') %>
