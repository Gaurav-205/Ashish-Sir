<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="page-head">
  <div>
    <div class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase;margin-bottom:4px">
      Mentor Workspace · Assigned Cohorts
    </div>
    <h1>Evaluator dashboard</h1>
    <p class="sub">Conduct your assigned candidate interviews, track meeting attendance, and submit rubric evaluations.</p>
  </div>
  <% if (mentor && (mentor.can_technical || mentor.can_hr)) { %>
    <div class="btn-row">
      <button type="button" class="btn primary" onclick="document.getElementById('createSlotModal').showModal()">+ Publish Slots</button>
    </div>
  <% } %>
</div>

<% if (mentor && (mentor.can_technical || mentor.can_hr)) { %>
<dialog id="createSlotModal" class="modal-dialog" style="max-width:540px">
  <div class="modal-head">
    <h2>Publish New Interview Slots</h2>
    <button type="button" class="modal-close-btn" onclick="document.getElementById('createSlotModal').close()" aria-label="Close">&times;</button>
  </div>
  <form method="post" action="/mentor/slots" style="margin:0">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="modal-body">
      <div class="field">
        <label>Interview Domain *</label>
        <select name="type" required>
          <% if (mentor.can_technical) { %><option value="technical">Technical Mock Interview</option><% } %>
          <% if (mentor.can_hr) { %><option value="hr">HR Mock Interview</option><% } %>
        </select>
      </div>

      <div class="row">
        <div class="field">
          <label>Start Date *</label>
          <input type="date" name="slot_date" id="m_slot_date" value="<%= typeof defaultDate !== 'undefined' ? defaultDate : '' %>" min="<%= typeof today !== 'undefined' ? today : '' %>" required onchange="updatePreview()">
        </div>
        <div class="field">
          <label>Schedule Duration</label>
          <select name="repeat_days" id="m_repeat_days" onchange="updatePreview()">
            <option value="1">1 Day (Single date)</option>
            <option value="3">3 Days in a row</option>
            <option value="5">5 Days (e.g. Mon–Fri)</option>
            <option value="7">7 Days (Full week)</option>
            <option value="10">10 Days</option>
            <option value="14">14 Days (2 weeks)</option>
            <option value="30">30 Days (1 month)</option>
          </select>
        </div>
      </div>

      <div style="margin-bottom:14px">
        <label style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:500;cursor:pointer">
          <input type="checkbox" name="exclude_weekends" value="1" id="m_exclude_weekends" checked style="width:auto;margin:0" onchange="updatePreview()">
          Skip Saturdays &amp; Sundays (Weekdays only)
        </label>
      </div>

      <div class="row">
        <div class="field">
          <label>Daily Start Time *</label>
          <input type="time" name="start_time" id="m_start_time" value="09:00" step="300" required onchange="updatePreview()">
        </div>
        <div class="field">
          <label>Slot Length (minutes)</label>
          <input type="number" name="duration" id="m_duration" value="30" min="10" max="180" onchange="updatePreview()" oninput="updatePreview()">
        </div>
        <div class="field">
          <label>Slots per Day</label>
          <input type="number" name="count" id="m_count" value="2" min="1" max="30" onchange="updatePreview()" oninput="updatePreview()">
        </div>
      </div>

      <div class="field">
        <label>Mode</label>
        <select name="mode">
          <option>Online (Auto Google Meet)</option>
          <option>Offline</option>
        </select>
      </div>

      <div style="margin-top:12px;background:var(--surface-alt, #f8fafc);padding:12px 14px;border-radius:8px;border:1px solid var(--line, #e2e8f0)">
        <label style="font-size:12px;font-weight:700;display:block;margin-bottom:6px;color:var(--slate, #64748b);text-transform:uppercase;letter-spacing:0.04em">Time Presets:</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          <button type="button" class="btn sm" onclick="applyPreset('09:00', 30, 2)">9:00 – 10:00 (2 slots)</button>
          <button type="button" class="btn sm" onclick="applyPreset('10:00', 30, 4)">10:00 – 12:00 (4 slots)</button>
          <button type="button" class="btn sm" onclick="applyPreset('14:00', 30, 6)">14:00 – 17:00 (6 slots)</button>
          <button type="button" class="btn sm" onclick="applyPreset('18:00', 30, 4)">18:00 – 20:00 (4 slots)</button>
        </div>
        <div id="m_preview_text" style="margin-top:10px;font-size:13px;font-weight:600;color:var(--action-blue, #2563eb)">
          ⚡ Generating: 2 slots/day × 1 day = 2 total slot(s)
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" onclick="document.getElementById('createSlotModal').close()">Cancel</button>
      <button class="btn primary">Publish Slots →</button>
    </div>
  </form>
</dialog>
<% } %>

<div class="stats">
  <div class="stat">
    <div class="n"><%= upcoming.length %></div>
    <div class="l">Upcoming Sessions</div>
  </div>
  <div class="stat">
    <div class="n"><%= completed.length %></div>
    <div class="l">Completed</div>
  </div>
  <div class="stat">
    <div class="n"><%= pending.length %></div>
    <div class="l">Awaiting Score</div>
  </div>
  <div class="stat">
    <div class="n"><%= slots.length %></div>
    <div class="l">Open Slots of Mine</div>
  </div>
</div>

<% if (pending.length) { %>
  <div class="note" style="display:flex;align-items:center;gap:10px">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;color:var(--warn)">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <div>
      Action needed: You have <strong><%= pending.length %></strong> completed interview(s) awaiting score submission.
    </div>
  </div>
<% } %>

<div class="card" style="margin-bottom:24px">
  <div class="card-head">
    <h2>Upcoming Interview Sessions (<%= upcoming.length %>)</h2>
  </div>
  <div class="card-body tight">
    <% if (!upcoming.length) { %>
      <div class="empty">No upcoming interview sessions scheduled currently.</div>
    <% } else { %>
    <div class="table-scroll"><table>
      <thead><tr><th>Date &amp; Time</th><th>Domain</th><th>Candidate</th><th>Mode &amp; Link</th><th class="num">Action</th></tr></thead>
      <tbody><% upcoming.forEach(function(i){ %>
        <tr>
          <td><%= h.fmtDate(i.slot_date) %><br><span class="faint"><%= h.fmtTime(i.start_time) %> – <%= h.fmtTime(i.end_time) %></span></td>
          <td><span class="pill p-<%= i.type %>"><%= h.titleCase(i.type) %></span></td>
          <td>
            <strong><%= i.student_name %></strong>
            <% if (i.squad) { %> <span class="pill p-<%= i.squad === '116' ? 'technical' : 'hr' %>" style="font-size:10px;padding:2px 6px">Squad <%= i.squad %></span><% } %>
            <br><span class="faint"><%= i.roll_no || '' %><%= i.branch ? ' · ' + i.branch : '' %></span>
          </td>
          <td class="faint"><%= i.mode %><% if (i.location) { %> · <%- h.linkify(i.location) %><% } %></td>
          <td class="num" style="white-space:nowrap">
            <div style="display:inline-flex;gap:6px;align-items:center">
              <a class="btn sm primary" href="/mentor/interview/<%= i.id %>">Open Session →</a>
              <form method="post" action="/mentor/slots/<%= i.slot_id %>/cancel" onsubmit="return confirm('Cancel this interview session? The candidate will be notified.')" style="margin:0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn sm danger">Cancel</button>
              </form>
            </div>
          </td>
        </tr>
      <% }); %></tbody>
    </table></div><% } %>
  </div>
</div>

<div class="card" style="margin-bottom:24px">
  <div class="card-head">
    <h2>Completed Sessions &amp; Evaluation Status</h2>
  </div>
  <div class="card-body tight">
    <% if (!completed.length) { %>
      <div class="empty">No completed interviews yet.</div>
    <% } else { %>
    <div class="table-scroll"><table>
      <thead><tr><th>Date &amp; Time</th><th>Domain</th><th>Candidate</th><th>Attendance</th><th>Evaluation</th><th class="num">Score</th><th class="num">Action</th></tr></thead>
      <tbody><% completed.forEach(function(i){ %>
        <tr>
          <td><%= h.fmtDate(i.slot_date) %><br><span class="faint"><%= h.fmtTime(i.start_time) %> – <%= h.fmtTime(i.end_time) %></span></td>
          <td><span class="pill p-<%= i.type %>"><%= h.titleCase(i.type) %></span></td>
          <td>
            <strong><%= i.student_name %></strong>
            <% if (i.squad) { %> <span class="pill p-<%= i.squad === '116' ? 'technical' : 'hr' %>" style="font-size:10px;padding:2px 6px">Squad <%= i.squad %></span><% } %>
          </td>
          <td>
            <% if (i.attendance === 'attended') { %>
              <span class="pill p-completed">Attended</span>
            <% } else if (i.attendance === 'absent') { %>
              <span class="pill p-cancelled">Absent</span>
            <% } else { %>
              <span class="pill p-booked">Pending</span>
            <% } %>
          </td>
          <td>
            <% if (i.eval_id) { %><span class="pill p-completed">Submitted</span>
            <% } else if (i.attendance === 'absent') { %><span class="faint">—</span>
            <% } else { %><span class="pill p-booked">Pending</span><% } %>
          </td>
          <td class="num">
            <% if (i.eval_id) { %><strong><%= i.score %></strong><span class="faint">/<%= RUBRIC[i.type].total %></span>
            <% } else { %><span class="faint">—</span><% } %>
          </td>
          <td class="num">
            <a class="btn sm <%= (i.eval_id || i.attendance === 'absent') ? '' : 'primary' %>" href="/mentor/interview/<%= i.id %>">
              <%= (i.eval_id || i.attendance === 'absent') ? 'View' : 'Score now →' %>
            </a>
          </td>
        </tr>
      <% }); %></tbody>
    </table></div><% } %>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <div>
      <h2 style="margin:0">My Open Published Slots (<%= slots.length %>)</h2>
      <span class="faint">Students can book into any of these slots</span>
    </div>
    <% if (mentor && (mentor.can_technical || mentor.can_hr)) { %>
      <button type="button" class="btn primary sm" onclick="document.getElementById('createSlotModal').showModal()">+ Publish Slots</button>
    <% } %>
  </div>
  <div class="card-body tight">
    <% if (!slots.length) { %>
      <div class="empty">
        You have no open upcoming slots.
        <% if (mentor && (mentor.can_technical || mentor.can_hr)) { %>
          <div style="margin-top:12px">
            <button type="button" class="btn primary sm" onclick="document.getElementById('createSlotModal').showModal()">+ Publish Slots Now</button>
          </div>
        <% } %>
      </div>
    <% } else { %>
    <div class="table-scroll"><table>
      <thead><tr><th>Date</th><th>Timing</th><th>Domain</th><th>Meeting Mode</th><th class="num">Action</th></tr></thead>
      <tbody><% slots.forEach(function(s){ %>
        <tr>
          <td><%= h.fmtDate(s.slot_date) %></td>
          <td><%= h.fmtTime(s.start_time) %> – <%= h.fmtTime(s.end_time) %></td>
          <td><span class="pill p-<%= s.type %>"><%= h.titleCase(s.type) %></span></td>
          <td class="faint"><%= s.mode %></td>
          <td class="num">
            <details class="inline"><summary>Manage</summary>
              <div class="panel" style="text-align:left;min-width:280px">
                <form method="post" action="/mentor/slots/<%= s.id %>/edit">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="row">
                    <div class="field"><label>Date</label><input type="date" name="slot_date" value="<%= s.slot_date %>" min="<%= typeof today !== 'undefined' ? today : '' %>" required></div>
                    <div class="field"><label>Start</label><input type="time" name="start_time" value="<%= s.start_time %>" step="300" required></div>
                    <div class="field"><label>End</label><input type="time" name="end_time" value="<%= s.end_time %>" step="300" required></div>
                  </div>
                  <div class="row">
                    <div class="field"><label>Mode</label><select name="mode">
                      <option <%= s.mode==='Online'?'selected':'' %>>Online</option>
                      <option <%= s.mode==='Offline'?'selected':'' %>>Offline</option></select></div>
                  </div>
                  <button class="btn primary sm" style="width:100%">Save changes</button>
                </form>
                <div class="btn-row" style="margin-top:10px">
                  <form method="post" action="/mentor/slots/<%= s.id %>/cancel" onsubmit="return confirm('Cancel this open slot?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn sm danger" style="width:100%">Cancel slot</button>
                  </form>
                </div>
              </div>
            </details>
          </td>
        </tr>
      <% }); %></tbody>
    </table></div><% } %>
  </div>
</div>
<script>
window.applyPreset = function (start, duration, count) {
  var s = document.querySelector('input[name="start_time"]');
  var d = document.querySelector('input[name="duration"]');
  var c = document.querySelector('input[name="count"]');
  if (s) s.value = start;
  if (d) d.value = duration;
  if (c) c.value = count;
  updatePreview();
};

window.updatePreview = function () {
  var repEl = document.getElementById('m_repeat_days');
  var countEl = document.getElementById('m_count');
  var prevEl = document.getElementById('m_preview_text');
  var exEl = document.getElementById('m_exclude_weekends');
  var dateEl = document.getElementById('m_slot_date');
  if (!repEl || !countEl || !prevEl) return;

  var days = parseInt(repEl.value, 10) || 1;
  var count = parseInt(countEl.value, 10) || 1;
  var ex = exEl && exEl.checked;
  var startDate = dateEl ? dateEl.value : '';

  var actualDays = days;
  if (ex && startDate && days > 1) {
    var valid = 0;
    for (var i = 0; i < days; i++) {
      var d = new Date(startDate + 'T00:00:00Z');
      d.setUTCDate(d.getUTCDate() + i);
      var day = d.getUTCDay();
      if (day !== 0 && day !== 6) valid++;
    }
    actualDays = valid;
  }

  var total = count * actualDays;
  prevEl.textContent = '⚡ Generating: ' + count + ' slots/day × ' + actualDays + ' day(s) = ' + total + ' total slot(s)';
};

var mentorModal = document.getElementById('createSlotModal');
if (mentorModal) {
  mentorModal.addEventListener('click', function (e) {
    var rect = mentorModal.getBoundingClientRect();
    var inDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
    if (!inDialog) mentorModal.close();
  });
}
</script>
<%- include('../partials/foot') %>
