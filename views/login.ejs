<%- include('partials/head') %>
<div class="announcement-bar">
  <span>✦ Konfident 2026 Enterprise Interview System · Placement Cohort 2025–26</span>
</div>
<div class="login-page">
  <div class="login-card">
    <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:14px">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <rect width="24" height="24" rx="6" fill="#17171c"/>
        <path d="M7 12L10.5 15.5L17 8.5" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="mono" style="font-size:11px;font-weight:700;letter-spacing:0.08em;color:var(--slate);text-transform:uppercase">
        Enterprise Workspace
      </span>
    </div>

    <h1>Sign in to Konfident</h1>
    <p class="sub">Structured Technical &amp; HR mock interviews with live calendar sync and mentor evaluation.</p>

    <% if (error) { %><div class="flash err"><%= error %></div><% } %>

    <form method="post" action="/login">
      <div class="field">
        <label for="email">Work / Academic Email</label>
        <input id="email" name="email" type="email" value="<%= email %>" placeholder="name@college.edu or mentor@konfident.in" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="••••••••" required>
      </div>
      <button class="btn primary" style="width:100%;justify-content:center;margin-top:6px;padding:12px 24px">
        Sign in with Password →
      </button>
    </form>

    <div class="auth-divider"><span>or continue with Google</span></div>

    <a href="/auth/google" class="btn btn-google" style="width:100%;justify-content:center;padding:11px 24px">
      <svg width="18" height="18" viewBox="0 0 24 24">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
      </svg>
      Sign in with Google
    </a>
    <% if (!googleConfigured) { %>
      <div class="hint" style="text-align:center;margin-top:8px;font-size:11px;display:flex;align-items:center;justify-content:center;gap:6px">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>Live Google Calendar sync activates when environment credentials are configured.</span>
      </div>
    <% } %>

    <div class="demo-creds">
      <strong style="color:var(--ink)">Demo Accounts</strong> <span class="faint">(Password: <code>pass123</code>)</span><br>
      Admin: <code>admin@konfident.in</code><br>
      Mentor: <code>arjun.mentor@konfident.in</code><br>
      Student: <code>aisha@student.in</code> · <code>harsh@student.in</code>
    </div>
  </div>
</div>
</body></html>
