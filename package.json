{
  "name": "konfident-interview-2025",
  "version": "1.0.0",
  "description": "Interview management system for Konfident Interview 2025 - students book slots, mentors evaluate, admin manages everything.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init": "node src/seed.js --clean",
    "seed": "node src/seed.js --dev",
    "seed:dev": "node src/seed.js --dev",
    "seed:mongo": "node scripts/seed-mongo.js",
    "empty-db": "node src/seed.js --empty",
    "migrate:mongo": "node scripts/migrate-to-mongo.js",
    "clean-db": "node src/seed.js --clean",
    "test": "node test/helpers.test.js && node test/views.test.js && node test/models.test.js && node test/queries.test.js && node test/validation-edge-cases.test.js && node test/e2e-mongo.js && node test/e2e-auth.js",
    "test:helpers": "node test/helpers.test.js",
    "test:models": "node test/models.test.js",
    "test:queries": "node test/queries.test.js",
    "test:validation": "node test/validation-edge-cases.test.js",
    "test:views": "node test/views.test.js",
    "test:e2e": "node test/e2e-mongo.js",
    "test:auth": "node test/e2e-auth.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "animejs": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.9.4"
  },
  "overrides": {
    "tar": "^7.5.21",
    "@tootallnate/once": "^2.0.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
